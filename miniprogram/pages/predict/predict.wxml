<view class="tool-page">
  <view style="height: {{statusBarHeight}}px"></view>
  <view class="tool-topbar">
    <text class="tool-back" bindtap="goBack">← 返回</text>
    <text class="tool-brand">YIDU</text>
  </view>

  <view wx:if="{{step === 'input'}}" class="fu">
    <view class="tool-head">
      <view class="tool-head-no">04</view>
      <view class="tool-kicker">RELATION FORECAST</view>
      <view class="tool-title"><view>这段关系</view><view>会走到哪里</view></view>
      <view class="tool-intro">不是算命。根据互动模式推演最可能的走向，重点看你们正在重复什么。</view>
    </view>
    <view wx:if="{{err}}" class="tool-error">{{err}}</view>
    <view wx:if="{{contextTip}}" class="context-tip">
      <view class="context-tip-head">
        <view style="flex: 1;">
          <view class="context-tip-title">带入关系历史</view>
          <view class="context-tip-sub">{{ctxEnabled ? '本次会带入档案与最近记录' : '本次只分析新内容'}}</view>
        </view>
        <switch checked="{{ctxEnabled}}" color="#2D2F33" bindchange="toggleCtxEnabled" style="transform: scale(0.78); transform-origin: right center;"></switch>
      </view>
      <view class="context-actions">
        <text class="context-link" bindtap="toggleCtxPreview">{{ctxPreviewOpen ? '收起内容' : '查看内容'}}</text>
        <text class="context-muted">{{profileHistoryCount}} 条历史摘要</text>
      </view>
      <view wx:if="{{ctxPreviewOpen}}" class="context-preview">{{ctx}}</view>
    </view>
    <view class="upload-zone {{imgs.length ? 'has-files' : ''}}" bindtap="chooseImg">
      <view class="upload-no">{{imgs.length ? imgs.length : '+'}}</view>
      <view>
        <view class="upload-title">{{imgs.length ? '聊天截图已就绪' : '选择聊天截图'}}</view>
        <view class="upload-sub">{{imgs.length ? '继续添加或点击下方预览' : '可一次多选，系统会按顺序理解对话'}}</view>
      </view>
      <view class="upload-arrow">↗</view>
    </view>

    <view wx:if="{{imgs.length}}" class="shot-panel">
      <view class="shot-head"><text>SCREENSHOTS / {{imgs.length}}</text><text bindtap="clearImgs">清空</text></view>
      <view class="shot-grid">
        <view wx:for="{{imgs}}" wx:key="path" class="shot-tile" data-index="{{index}}" bindtap="previewImg">
          <image class="shot-img" src="{{item.path}}" mode="aspectFill"></image>
          <view class="shot-remove" data-index="{{index}}" catchtap="removeImg">×</view>
          <view class="shot-order">0{{index + 1}}</view>
        </view>
      </view>
    </view>

    <view class="or-line"><text>或粘贴聊天文字</text></view>
    <view class="tool-surface">
      <view class="surface-label">CHAT HISTORY</view>
      <textarea class="tool-textarea" maxlength="-1" auto-height placeholder="粘贴聊天记录，越完整越接近真实走向…" placeholder-style="color: #B7BBC4" value="{{text}}" bindinput="onInput"></textarea>
    </view>
    <button class="tool-primary" disabled="{{!hasInput}}" bindtap="nextStep">
      <text>继续补充关系背景</text><text class="tool-primary-arrow">↗</text>
    </button>
  </view>

  <view wx:if="{{step === 'context'}}" class="fu">
    <view class="tool-head compact">
      <view class="tool-kicker">RELATION CONTEXT</view>
      <view class="tool-title"><view>Ta 是你的</view><view>什么人</view></view>
      <view class="tool-intro">例如：暧昧三个月、同事、每次靠近后又消失。</view>
    </view>
    <view class="tool-surface">
      <textarea class="tool-textarea context-area" auto-height placeholder="补充关系、时长和最困扰你的模式…" placeholder-style="color: #B7BBC4" value="{{ctx}}" bindinput="onCtxInput"></textarea>
      <view wx:if="{{contextTip}}" class="context-inline">
        <text>{{ctxEnabled ? '历史档案已开启' : '历史档案已关闭'}}</text>
        <switch checked="{{ctxEnabled}}" color="#2D2F33" bindchange="toggleCtxEnabled" style="transform: scale(0.72);"></switch>
      </view>
    </view>
    <view class="tool-button-row">
      <button class="tool-secondary" bindtap="backToInput">返回修改</button>
      <button class="tool-primary no-margin" disabled="{{submitting}}" bindtap="submit"><text>生成预测</text><text>↗</text></button>
    </view>
  </view>

  <view wx:if="{{step === 'loading'}}" class="fu loading-stage">
    <view class="loading-index">04</view>
    <view class="loading-title">{{loadingMsg}}</view>
    <view class="loading-sub">正在把互动模式放进时间线，不替你美化结果。</view>
    <view class="loading-bar"><view></view></view>
  </view>

  <view wx:if="{{step === 'result' && res}}" class="fu">
    <view class="result-lead">
      <view class="result-kicker">CURRENT STAGE</view>
      <view class="result-title">{{res.stage}}</view>
      <view class="result-copy">{{res.stage_desc}}</view>
    </view>

    <view class="result-section">
      <view class="result-section-label">TIMELINE / 未来轨迹</view>
      <view wx:for="{{res.predictions}}" wx:key="index" class="timeline-row">
        <view class="timeline-index">0{{index + 1}}</view>
        <view class="timeline-body">
          <view class="timeline-head"><text>{{item.time}}</text><text>{{item.prob}}%</text></view>
          <view class="timeline-copy">{{item.scene}}</view>
          <view class="timeline-track"><view style="width: {{item.prob}}%;"></view></view>
        </view>
      </view>
    </view>

    <view class="turning-block">
      <view class="result-section-label">TURNING POINT</view>
      <view>{{res.turning}}</view>
    </view>

    <view class="scenario-grid">
      <view><text>BEST CASE</text><view>{{res.best}}</view></view>
      <view><text>WORST CASE</text><view>{{res.worst}}</view></view>
    </view>

    <view class="todo-block">
      <view class="result-section-label">DO THIS NOW</view>
      <view>{{res.todo}}</view>
    </view>

    <button class="tool-primary" bindtap="goReply"><text>帮我写下一句</text><text>↗</text></button>
    <view class="result-action-grid">
      <button class="result-action" bindtap="resetInput">重新预测</button>
      <button class="result-action" bindtap="copyResult">复制结果</button>
      <button class="result-action dark" open-type="share">分享给朋友 ↗</button>
    </view>
    <view class="disclaimer">关系会被新的选择改写。预测结果不是结局通知书，只是提醒你别重复同一个坑。</view>
  </view>
</view>
