<view class="record-page">
  <view style="height: {{statusBarHeight}}px"></view>

  <view class="record-topbar">
    <text class="record-back" bindtap="goBack">← 返回</text>
    <text wx:if="{{record}}" class="record-delete" bindtap="deleteRecord">删除记录</text>
  </view>

  <view wx:if="{{!record}}" class="record-missing">
    <view class="missing-no">404</view>
    <view class="missing-kicker">RECORD NOT FOUND</view>
    <view class="missing-title">记录找不到了</view>
    <view class="missing-copy">可能已经被清空或删除。</view>
  </view>

  <view wx:if="{{record}}" class="record-content">
    <view class="record-hero">
      <view class="record-kicker">{{record.kindLabel}}</view>
      <view class="record-time">{{record.timeText}}</view>
      <view class="record-title">{{record.title}}</view>
      <view wx:if="{{record.profileName}}" class="record-profile">RELATION FILE / {{record.profileName}}</view>
      <view class="record-summary">{{record.summary}}</view>

      <view wx:if="{{record.input}}" class="record-input">
        <view>ORIGINAL INPUT</view>
        <text>{{record.input}}</text>
      </view>
      <view wx:if="{{record.imageCount}}" class="record-images">SCREENSHOTS / {{record.imageCount}}</view>
    </view>

    <view wx:if="{{record.kind === 'quiz' && res.scores}}" class="record-section">
      <view class="section-head">
        <text>01 / FOUR-DIMENSION SCORE</text>
        <view>各维度得分</view>
      </view>
      <view class="score-grid">
        <view><text>焦虑</text><text>{{res.scores.anxious}}</text></view>
        <view><text>回避</text><text>{{res.scores.avoidant}}</text></view>
        <view><text>安全</text><text>{{res.scores.secure}}</text></view>
        <view><text>混乱</text><text>{{res.scores.disorganized}}</text></view>
      </view>
      <view wx:if="{{res.desc}}" class="section-copy">{{res.desc}}</view>
    </view>

    <view wx:if="{{record.kind === 'diagnose' && res}}" class="record-section">
      <view class="section-head">
        <text>01 / INTERACTION LOOP</text>
        <view>完整分析</view>
      </view>

      <view class="duo-summary">
        <view><text>你</text><view>{{res.user_label}}</view></view>
        <view class="dark"><text>Ta</text><view>{{res.partner_label}}</view></view>
      </view>

      <view class="confidence">
        <view><text>分析置信度</text><text>{{res.confidence}}%</text></view>
        <view class="confidence-track"><view style="width: {{res.confidence}}%;"></view></view>
      </view>

      <view class="section-copy">{{res.match}}</view>

      <view wx:if="{{record.profileId}}" class="profile-sync">
        <view class="sync-copy">
          <view>写回关系档案</view>
          <text>{{record.profileName || '这段关系'}}：Ta 标记为 {{res.partner_label}}</text>
        </view>
        <button class="profile-sync-btn {{profileSynced ? 'done' : ''}}" disabled="{{profileSynced}}" bindtap="syncPartnerType">{{profileSynced ? '已更新' : '写入'}}</button>
      </view>

      <view class="subsection-label">02 / EXPOSED SIGNALS</view>
      <view wx:for="{{res.signals}}" wx:key="index" class="numbered-row">
        <view class="row-no">0{{index + 1}}</view>
        <view class="row-body">
          <view class="row-meta">{{item.who}}</view>
          <view class="row-title">「{{item.msg}}」</view>
          <view class="row-copy">{{item.meaning}}</view>
        </view>
      </view>

      <view class="advice-grid">
        <view><text>给你</text><view>{{res.user_advice}}</view></view>
        <view class="dark"><text>应对 Ta</text><view>{{res.partner_advice}}</view></view>
      </view>
    </view>

    <view wx:if="{{record.kind === 'translate' && res.translations}}" class="translations">
      <view wx:for="{{res.translations}}" wx:key="index" class="record-section translation-section">
        <view class="section-head">
          <text>0{{index + 1}} / SUBTEXT</text>
          <view>潜台词 {{index + 1}}</view>
        </view>
        <view class="quote-line">「{{item.original}}」</view>
        <view class="translation-verdict">{{item.verdict}}</view>
        <view wx:for="{{item.possibilities}}" wx:for-item="p" wx:key="label" class="numbered-row">
          <view class="row-no">{{p.label}}</view>
          <view class="row-body">
            <view class="poss-head"><text>{{p.meaning}}</text><text>{{p.percent}}%</text></view>
            <view class="row-copy">{{p.reason}}</view>
          </view>
        </view>
        <view class="highlight-block"><text>最可能</text><view>{{item.most_likely}}，{{item.why}}</view></view>
      </view>
    </view>

    <view wx:if="{{record.kind === 'check' && res}}" class="record-section">
      <view class="section-head">
        <text>01 / MESSAGE CHECK</text>
        <view>发送建议</view>
      </view>
      <view class="verdict-band {{res.danger ? 'danger' : 'safe'}}">
        <text>{{res.danger ? 'HIGH RISK' : 'LOW RISK'}}</text>
        <view>{{res.verdict}}</view>
      </view>
      <view wx:if="{{res.type_note}}" class="section-copy">{{res.type_note}}</view>
      <view class="fact-grid">
        <view><text>会触发</text><view>{{res.trigger}}</view></view>
        <view><text>Ta 可能会</text><view>{{res.prediction}}</view></view>
      </view>
      <view class="highlight-block"><text>替代消息</text><view>「{{res.alternative}}」</view></view>
      <view class="section-copy">{{res.reason}}</view>
    </view>

    <view wx:if="{{record.kind === 'reply' && res}}" class="record-section">
      <view class="section-head">
        <text>01 / REPLY OPTIONS</text>
        <view>回复建议</view>
      </view>
      <view class="section-copy first-copy">{{res.strategy}}</view>
      <view wx:for="{{res.drafts}}" wx:key="label" class="reply-option">
        <view class="reply-meta"><text>{{item.label}}</text><text>可直接发</text></view>
        <view class="reply-text">「{{item.text}}」</view>
        <view class="reply-why">{{item.why}}</view>
      </view>
      <view class="highlight-block warning"><text>别发</text><view>{{res.avoid}}</view></view>
      <view wx:if="{{res.note}}" class="highlight-block"><text>类型提醒</text><view>{{res.note}}</view></view>
    </view>

    <view wx:if="{{record.kind === 'misread' && res && res.safe}}" class="record-section misread-record">
      <view class="section-head">
        <text>01 / MISREAD REPLY</text>
        <view>给「{{res.mode === 'crush' ? 'Crush' : '人'}}」的乱回</view>
      </view>
      <view class="misread-source"><text>Ta说</text><view>{{res.source}}</view></view>
      <view wx:for="{{res.replies}}" wx:key="index" class="misread-option">
        <view class="misread-option-head"><text>0{{index + 1}}</text><text>{{item.type}}</text></view>
        <view class="misread-option-text">{{item.text}}</view>
        <view class="misread-option-warning">{{item.warning}}</view>
      </view>
    </view>

    <view wx:if="{{record.kind === 'misread' && res && !res.safe}}" class="record-section misread-record">
      <view class="section-head">
        <text>01 / SAFETY CHECK</text>
        <view>建议认真回复</view>
      </view>
      <view class="misread-source"><text>Ta说</text><view>{{res.source}}</view></view>
      <view class="misread-safety">{{res.safety_message}}</view>
      <view wx:if="{{res.serious_reply}}" class="highlight-block"><text>可以先回</text><view>「{{res.serious_reply}}」</view></view>
    </view>

    <view wx:if="{{record.kind === 'predict' && res}}" class="record-section">
      <view class="section-head">
        <text>01 / RELATION FORECAST</text>
        <view>走向预测</view>
      </view>
      <view class="stage-title">{{res.stage}}</view>
      <view class="section-copy">{{res.stage_desc}}</view>

      <view class="subsection-label">02 / TIMELINE</view>
      <view wx:for="{{res.predictions}}" wx:key="index" class="numbered-row prediction-row">
        <view class="row-no">0{{index + 1}}</view>
        <view class="row-body">
          <view class="poss-head"><text>{{item.time}}</text><text>{{item.prob}}%</text></view>
          <view class="row-copy">{{item.scene}}</view>
          <view class="prob-track"><view style="width: {{item.prob}}%;"></view></view>
        </view>
      </view>

      <view class="highlight-block"><text>转折点</text><view>{{res.turning}}</view></view>
      <view class="highlight-block dark"><text>现在该做</text><view>{{res.todo}}</view></view>
    </view>

    <view class="record-actions">
      <button bindtap="copyRecord">复制结果</button>
      <button class="dark" bindtap="reAnalyze">再分析一次 ↗</button>
    </view>

    <view wx:if="{{feedbackView}}" class="record-feedback">
      <view class="feedback-kicker">FOLLOW UP</view>
      <view class="feedback-grid">
        <view wx:if="{{feedbackView.action}}">
          <text>你的动作</text>
          <view>{{feedbackView.action}}</view>
        </view>
        <view wx:if="{{feedbackView.response}}">
          <text>Ta 的反应</text>
          <view>{{feedbackView.response}}</view>
        </view>
      </view>
    </view>
  </view>
</view>
