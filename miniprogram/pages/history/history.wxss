.history-page {
  min-height: 100vh;
  padding: 0 36rpx 120rpx;
  box-sizing: border-box;
  background: #F3F4F8;
  overflow-x: hidden;
}

.history-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  border-bottom: 2rpx solid rgba(45,47,51,0.07);
}

.history-back,
.history-clear {
  color: #2D2F33;
  font-size: 25rpx;
  font-weight: 900;
}

.history-clear {
  color: #E17055;
}

.history-head {
  position: relative;
  padding: 52rpx 4rpx 44rpx;
  overflow: hidden;
}

.history-head-no {
  position: absolute;
  top: 20rpx;
  right: 0;
  color: transparent;
  -webkit-text-stroke: 2rpx rgba(45,47,51,0.08);
  font-size: 152rpx;
  font-weight: 900;
  line-height: 1;
}

.history-kicker,
.empty-kicker,
.history-count text:first-child {
  position: relative;
  color: #10A8E8;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.history-title {
  position: relative;
  margin-top: 18rpx;
  color: #2D2F33;
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1.12;
}

.history-intro {
  position: relative;
  margin-top: 20rpx;
  color: rgba(45,47,51,0.54);
  font-size: 25rpx;
  line-height: 1.72;
}

.history-empty {
  position: relative;
  padding: 54rpx 32rpx 38rpx;
  border-top: 6rpx solid #10A8E8;
  background: #FFFFFF;
  overflow: hidden;
}

.empty-no {
  position: absolute;
  top: -34rpx;
  right: 10rpx;
  color: transparent;
  -webkit-text-stroke: 2rpx rgba(45,47,51,0.08);
  font-size: 154rpx;
  font-weight: 900;
  line-height: 1;
}

.empty-title {
  position: relative;
  margin-top: 14rpx;
  color: #2D2F33;
  font-size: 38rpx;
  font-weight: 900;
}

.empty-copy {
  position: relative;
  width: 86%;
  margin-top: 14rpx;
  color: rgba(45,47,51,0.52);
  font-size: 24rpx;
  line-height: 1.72;
}

.history-count {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 12rpx 4rpx 18rpx;
}

.history-count text:last-child {
  color: rgba(45,47,51,0.42);
  font-size: 21rpx;
  font-weight: 800;
}

.history-sheet {
  width: 100%;
  margin-bottom: 28rpx;
  padding: 32rpx 30rpx 0;
  border-top: 6rpx solid #10A8E8;
  box-sizing: border-box;
  background: #FFFFFF;
  overflow: hidden;
}

.sheet-meta,
.sheet-link,
.score-preview view {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.sheet-meta {
  color: #B8BDC8;
  font-size: 20rpx;
}

.sheet-meta text:first-child {
  color: #10A8E8;
  font-weight: 900;
  letter-spacing: 1rpx;
}

.sheet-title {
  margin-top: 22rpx;
  color: #2D2F33;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.sheet-profile {
  margin-top: 12rpx;
  color: #10A8E8;
  font-size: 20rpx;
  font-weight: 900;
}

.sheet-summary {
  margin-top: 14rpx;
  color: rgba(45,47,51,0.62);
  font-size: 25rpx;
  line-height: 1.72;
}

.sheet-input,
.sheet-result {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  background: #F3F4F8;
}

.sheet-input view,
.sheet-result view {
  margin-bottom: 8rpx;
  color: #10A8E8;
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.sheet-input text,
.sheet-result text {
  display: block;
  color: rgba(45,47,51,0.68);
  font-size: 23rpx;
  line-height: 1.68;
  overflow-wrap: anywhere;
}

.sheet-images {
  margin-top: 18rpx;
  color: #10A8E8;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.score-preview {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: 22rpx;
  border-top: 2rpx solid rgba(45,47,51,0.08);
  border-left: 2rpx solid rgba(45,47,51,0.08);
}

.score-preview view {
  min-height: 68rpx;
  padding: 0 16rpx;
  border-right: 2rpx solid rgba(45,47,51,0.08);
  border-bottom: 2rpx solid rgba(45,47,51,0.08);
  box-sizing: border-box;
  color: rgba(45,47,51,0.5);
  font-size: 21rpx;
  font-weight: 800;
}

.score-preview text:last-child {
  color: #2D2F33;
  font-size: 24rpx;
  font-weight: 900;
}

.sheet-link {
  min-height: 84rpx;
  margin-top: 22rpx;
  border-top: 2rpx solid rgba(45,47,51,0.08);
  color: #2D2F33;
  font-size: 24rpx;
  font-weight: 900;
}

.sheet-link text:last-child {
  font-size: 30rpx;
}
