<view class="history-page">
  <view style="height: {{statusBarHeight}}px"></view>

  <view class="history-topbar">
    <text class="history-back" bindtap="goBack">← 返回</text>
    <text wx:if="{{records.length}}" class="history-clear" bindtap="clearHistory">清空记录</text>
  </view>

  <view class="history-head">
    <view class="history-head-no">05</view>
    <view class="history-kicker">RECENT RECORDS</view>
    <view class="history-title">最近分析</view>
    <view class="history-intro">所有记录只保存在本机，最多保留 50 条。</view>
  </view>

  <view wx:if="{{!records.length}}" class="history-empty">
    <view class="empty-no">00</view>
    <view class="empty-kicker">NO RECORDS YET</view>
    <view class="empty-title">还没有分析记录</view>
    <view class="empty-copy">完成一次测试、确诊或关系分析后，结果会自动出现在这里。</view>
  </view>

  <view wx:if="{{records.length}}" class="history-count">
    <text>ANALYSIS ARCHIVE</text>
    <text>{{records.length}} 条记录</text>
  </view>

  <view
    wx:for="{{records}}"
    wx:key="id"
    class="history-sheet"
    data-id="{{item.id}}"
    bindtap="openDetail"
  >
    <view class="sheet-meta">
      <text>{{item.kindLabel}}</text>
      <text>{{item.timeText}}</text>
    </view>

    <view class="sheet-title">{{item.title}}</view>
    <view wx:if="{{item.profileName}}" class="sheet-profile">关系档案 / {{item.profileName}}</view>
    <view class="sheet-summary">{{item.summary}}</view>

    <view wx:if="{{item.input}}" class="sheet-input">
      <view>INPUT</view>
      <text>{{item.input}}</text>
    </view>

    <view wx:if="{{item.imageCount}}" class="sheet-images">SCREENSHOTS / {{item.imageCount}}</view>

    <view wx:if="{{item.kind === 'quiz' && item.result.scores}}" class="score-preview">
      <view><text>焦虑</text><text>{{item.result.scores.anxious}}</text></view>
      <view><text>回避</text><text>{{item.result.scores.avoidant}}</text></view>
      <view><text>安全</text><text>{{item.result.scores.secure}}</text></view>
      <view><text>混乱</text><text>{{item.result.scores.disorganized}}</text></view>
    </view>

    <view wx:if="{{item.kind === 'check' && item.result.alternative}}" class="sheet-result">
      <view>替代消息</view>
      <text>「{{item.result.alternative}}」</text>
    </view>

    <view wx:if="{{item.kind === 'reply' && item.result.drafts && item.result.drafts.length}}" class="sheet-result">
      <view>推荐回复</view>
      <text>「{{item.result.drafts[0].text}}」</text>
    </view>

    <view wx:if="{{item.kind === 'misread' && item.result.safe && item.result.replies && item.result.replies.length}}" class="sheet-result">
      <view>乱回候选</view>
      <text>「{{item.result.replies[0].text}}」</text>
    </view>

    <view wx:if="{{item.kind === 'misread' && !item.result.safe}}" class="sheet-result">
      <view>安全提醒</view>
      <text>{{item.result.safety_message}}</text>
    </view>

    <view wx:if="{{item.kind === 'predict' && item.result.todo}}" class="sheet-result">
      <view>现在该做</view>
      <text>{{item.result.todo}}</text>
    </view>

    <view class="sheet-link">
      <text>查看完整结果</text>
      <text>↗</text>
    </view>
  </view>
</view>
