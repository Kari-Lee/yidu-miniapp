.surface-label {
  color: #A3A8B2;
  font-size: 17rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
}
.type-selector { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8rpx; }
.type-selector view {
  min-height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(45,47,51,0.08);
  background: rgba(255,255,255,0.55);
  color: #8D929D;
  font-size: 21rpx;
  font-weight: 900;
}
.type-selector view.active { background: #2D2F33; color: #FFFFFF; border-color: #2D2F33; }
.verdict-hero {
  margin-top: 38rpx;
  padding: 44rpx 34rpx;
  border-top: 8rpx solid #2D2F33;
  background: rgba(255,255,255,0.65);
}
.verdict-hero.danger { border-color: #E17055; }
.verdict-hero.safe { border-color: #00B894; }
.verdict-word { margin-top: 18rpx; color: #2D2F33; font-size: 78rpx; font-weight: 900; line-height: 1; }
.verdict-note { margin-top: 24rpx; color: rgba(45,47,51,0.62); font-size: 24rpx; line-height: 1.7; }
.risk-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 12rpx;
  margin-top: 12rpx;
}
.risk-grid > view { min-height: 150rpx; padding: 26rpx; background: #2D2F33; color: #FFFFFF; box-sizing: border-box; }
.risk-grid > view:last-child { background: rgba(255,255,255,0.66); color: #2D2F33; }
.risk-grid text { color: #E17055; font-size: 18rpx; font-weight: 900; }
.risk-grid view view { margin-top: 12rpx; font-size: 23rpx; font-weight: 800; line-height: 1.6; overflow-wrap: anywhere; }
.alternative-block { margin-top: 12rpx; padding: 34rpx; border-left: 7rpx solid #10A8E8; background: rgba(255,255,255,0.68); }
.alternative-text { margin-top: 17rpx; color: #2D2F33; font-size: 32rpx; font-weight: 900; line-height: 1.65; }
.reply-row { padding: 32rpx 0; border-top: 2rpx solid rgba(45,47,51,0.08); }
.reply-head { display: flex; justify-content: space-between; color: #10A8E8; font-size: 19rpx; font-weight: 900; }
.reply-head text:last-child { color: #A3A8B2; }
.reply-text { margin-top: 17rpx; color: #2D2F33; font-size: 31rpx; font-weight: 900; line-height: 1.65; }
.reply-why { margin-top: 14rpx; color: #858B96; font-size: 22rpx; line-height: 1.7; }
.avoid-block { padding: 30rpx; background: #2D2F33; color: #FFFFFF; }
.avoid-block .result-section-label { color: #E17055; }
.avoid-block > view:last-child { margin-top: 13rpx; font-size: 25rpx; line-height: 1.7; }
.type-note { margin-top: 12rpx; padding: 28rpx; background: rgba(255,255,255,0.62); }
.type-note text { color: #10A8E8; font-size: 19rpx; font-weight: 900; }
.type-note view { margin-top: 10rpx; color: #656B76; font-size: 23rpx; line-height: 1.7; }
