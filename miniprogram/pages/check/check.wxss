.loading-dots { display: flex; gap: 8rpx; }
.loading-dots view {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: linear-gradient(135deg, #00B894, #00896F);
  animation: bounce 0.9s ease infinite;
}
.loading-dots view:nth-child(2) { animation-delay: 0.15s; }
.loading-dots view:nth-child(3) { animation-delay: 0.3s; }
@keyframes bounce {
  0%, 100% { transform: translateY(0); opacity: 0.4; }
  50% { transform: translateY(-6px); opacity: 1; }
}
.skeleton {
  border-radius: 40rpx;
  background: linear-gradient(90deg, rgba(0,0,0,0.04), #F8FAFB, rgba(0,0,0,0.04));
  background-size: 200% 100%; animation: shimmer 1.5s infinite;
}

.reply-card {
  padding: 38rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 32rpx rgba(0,0,0,0.04);
  margin-bottom: 24rpx;
}

.reply-label {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(0,184,148,0.08);
  color: #00B894;
  font-size: 22rpx;
  font-weight: 900;
}

.reply-text {
  color: #1A1A2E;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.75;
}

.reply-why {
  margin-top: 18rpx;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #F8FAFB;
  color: #8395A7;
  font-size: 24rpx;
  line-height: 1.7;
}
