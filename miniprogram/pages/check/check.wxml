<view class="container" style="padding: 0 32rpx 120rpx;">
  <view style="height: {{statusBarHeight}}px"></view>
  <view style="padding: 24rpx 0;">
    <text bindtap="goBack" style="font-size: 24rpx; color: #B8860B; font-weight: 600;">‹ 返回</text>
  </view>

  <view wx:if="{{step === 'input'}}" class="fu">
    <view wx:if="{{err}}" style="padding: 28rpx 36rpx; background: #FFF5F5; border-radius: 28rpx; margin-bottom: 28rpx; font-size: 26rpx; color: #E17055;">{{err}}</view>
    <view class="notice">
      <view class="notice-title">先救消息，再救关系</view>
      <view>别贴隐私信息。这里给的是沟通风险提示，不是让 AI 替你谈恋爱，最后按不按发送还是你负责。</view>
    </view>
    <view class="card" style="padding: 52rpx;">
      <view style="margin-bottom: 36rpx;">
        <view class="serif" style="font-size: 30rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 24rpx;">Ta的依恋类型</view>
        <view style="display: flex; gap: 16rpx; flex-wrap: wrap;">
          <view wx:for="{{typeOptions}}" wx:key="key" bindtap="pickType" data-key="{{item.key}}"
            style="padding: 18rpx 30rpx; border-radius: 28rpx; border: 4rpx solid {{pType === item.key ? item.color : 'rgba(0,0,0,0.04)'}}; background: {{pType === item.key ? item.bg : '#fff'}}; color: {{pType === item.key ? item.color : '#8395A7'}}; font-size: 26rpx; font-weight: 600;">
            {{item.emoji}} {{item.label}}
          </view>
        </view>
      </view>
      <textarea style="width: 100%; padding: 28rpx 8rpx; background: transparent; border: none; color: #1A1A2E; font-size: 30rpx; line-height: 1.9;" maxlength="-1" auto-height placeholder="你想发的消息..." placeholder-style="color: #C8D6E5" value="{{text}}" bindinput="onInput"></textarea>
    </view>
    <button class="btn-main" style="margin-top: 32rpx; background: {{hasInput ? '#00B894' : '#ddd'}};" disabled="{{!hasInput}}" bindtap="submit">检测 💊</button>
  </view>

  <view wx:if="{{step === 'loading'}}" class="fu" style="text-align: center;">
    <view style="display: inline-flex; align-items: center; gap: 20rpx; padding: 28rpx 56rpx; border-radius: 999rpx; background: #fff; box-shadow: 0 8rpx 48rpx rgba(0,0,0,0.06); margin-bottom: 40rpx;">
      <view class="loading-dots"><view></view><view></view><view></view></view>
      <text style="font-size: 26rpx; color: #8395A7;">{{loadingMsg}}</text>
    </view>
    <view style="opacity: 0.5;">
      <view class="skeleton" style="height: 300rpx; margin-bottom: 28rpx;"></view>
      <view class="skeleton" style="height: 200rpx;"></view>
    </view>
  </view>

  <view wx:if="{{step === 'result' && res}}" class="fu">
    <view class="card" style="padding: 48rpx;">
      <view style="text-align: center; padding: 64rpx 40rpx 56rpx; margin-bottom: 40rpx; border-radius: 44rpx; background: {{res.danger ? 'linear-gradient(135deg,#FFF5F3,#FFE3E3)' : 'linear-gradient(135deg,#F0FFF4,#D3F9D8)'}};">
        <view style="font-size: 104rpx; margin-bottom: 20rpx;">{{res.danger ? '🚨' : '✅'}}</view>
        <view class="serif" style="font-size: 76rpx; font-weight: 900; color: {{res.danger ? '#C4616C' : '#00B894'}};">{{res.verdict}}</view>
      </view>
      <view wx:if="{{res.type_note}}" style="padding: 28rpx 36rpx; background: #F8FAFB; border-radius: 28rpx; margin-bottom: 32rpx; font-size: 28rpx; color: rgba(26,26,46,0.8); line-height: 1.8;">🎯 {{res.type_note}}</view>
      <view wx:if="{{res.danger}}">
        <view style="display: flex; gap: 20rpx; margin-bottom: 28rpx;">
          <view style="flex: 1; padding: 32rpx; background: #FFF5F3; border-radius: 28rpx;">
            <view style="font-size: 22rpx; color: #C8D6E5; font-weight: 700; margin-bottom: 8rpx;">会触发</view>
            <view style="font-size: 26rpx; font-weight: 800; color: #E17055;">{{res.trigger}}</view>
          </view>
          <view style="flex: 1; padding: 32rpx; background: #F8FAFB; border-radius: 28rpx;">
            <view style="font-size: 22rpx; color: #C8D6E5; font-weight: 700; margin-bottom: 8rpx;">Ta会</view>
            <view style="font-size: 26rpx; color: rgba(26,26,46,0.8);">{{res.prediction}}</view>
          </view>
        </view>
        <view style="padding: 44rpx; border-radius: 36rpx; background: linear-gradient(135deg,#F0FFF4,#E6FCF5); border: 4rpx solid #C3FAE8;">
          <view style="font-size: 24rpx; font-weight: 800; color: #00B894; margin-bottom: 16rpx;">✨ 替代版本</view>
          <view class="serif" style="font-size: 34rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 12rpx;">「{{res.alternative}}」</view>
          <view style="font-size: 24rpx; color: #8395A7;">→ {{res.reason}}</view>
        </view>
      </view>
      <view wx:if="{{!res.danger}}" style="padding: 36rpx; background: #F0FFF4; border-radius: 28rpx;">
        <view style="font-size: 28rpx; color: rgba(26,26,46,0.8); line-height: 1.8;">{{res.reason}}</view>
      </view>
    </view>
    <view style="display: flex; gap: 20rpx; margin-top: 16rpx;">
      <button class="btn-reset" style="flex: 1;" bindtap="resetInput">再来一次 ↻</button>
      <button class="btn-main" style="flex: 1; background: #00B894;" open-type="share">分享</button>
    </view>
    <view class="disclaimer">发送建议只基于当前文本和你选择的类型，不代表对方一定会这样反应。冲动发言前，先喝口水。</view>
  </view>
</view>
