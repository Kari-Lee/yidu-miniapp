<view class="tool-page">
  <view style="height: {{statusBarHeight}}px"></view>
  <view class="tool-topbar">
    <text class="tool-back" bindtap="goBack">← 返回</text>
    <text class="tool-brand">YIDU</text>
  </view>

  <view wx:if="{{step === 'input'}}" class="fu">
    <view class="tool-head">
      <view class="tool-head-no">03</view>
      <view class="tool-kicker">{{isReplyMode ? 'REPLY WRITER' : 'MESSAGE CHECK'}}</view>
      <view class="tool-title">
        <view>{{isReplyMode ? '下一句' : '这句话'}}</view>
        <view>{{isReplyMode ? '怎么回' : '到底发不发'}}</view>
      </view>
      <view class="tool-intro">{{isReplyMode ? '给你能直接发出去的话，不卑微、不攻击，也不拿体面换沉默。' : '先看这句话会触发什么，再决定要不要让情绪替你按发送。'}}</view>
    </view>
    <view wx:if="{{err}}" class="tool-error">{{err}}</view>

    <view wx:if="{{contextTip}}" class="context-tip">
      <view class="context-tip-head">
        <view style="flex: 1;">
          <view class="context-tip-title">带入关系历史</view>
          <view class="context-tip-sub">{{ctxEnabled ? '本次会参考档案和最近记录' : '本次只看这条消息'}}</view>
        </view>
        <switch checked="{{ctxEnabled}}" color="#2D2F33" bindchange="toggleCtxEnabled" style="transform: scale(0.78);"></switch>
      </view>
      <view class="context-actions">
        <text class="context-link" bindtap="toggleCtxPreview">{{ctxPreviewOpen ? '收起内容' : '查看内容'}}</text>
        <text class="context-muted">{{profileHistoryCount}} 条历史摘要</text>
      </view>
      <view wx:if="{{ctxPreviewOpen}}" class="context-preview">{{ctx}}</view>
    </view>

    <view class="tool-surface">
      <view class="surface-label">THEIR ATTACHMENT STYLE</view>
      <view class="type-selector">
        <view wx:for="{{typeOptions}}" wx:key="key" class="{{pType === item.key ? 'active' : ''}}" bindtap="pickType" data-key="{{item.key}}">{{item.label}}</view>
      </view>
      <view class="tool-rule"></view>
      <view class="surface-label">{{isReplyMode ? 'WHAT YOU WANT TO SAY' : 'MESSAGE TO CHECK'}}</view>
      <textarea class="tool-textarea" maxlength="-1" auto-height placeholder="{{isReplyMode ? '你真正想表达什么？' : '把准备发送的话贴在这里…'}}" placeholder-style="color: #B7BBC4" value="{{text}}" bindinput="onInput"></textarea>
    </view>
    <button class="tool-primary" disabled="{{!hasInput || submitting}}" bindtap="submit"><text>{{isReplyMode ? '生成可发回复' : '检查发送风险'}}</text><text>↗</text></button>
  </view>

  <view wx:if="{{step === 'loading'}}" class="fu loading-stage">
    <view class="loading-index">03</view>
    <view class="loading-title">{{loadingMsg}}</view>
    <view class="loading-sub">{{isReplyMode ? '正在把情绪降下来，把边界留下来。' : '正在模拟 Ta 看到后的第一反应。'}}</view>
    <view class="loading-bar"><view></view></view>
  </view>

  <view wx:if="{{step === 'result' && res && !isReplyMode}}" class="fu">
    <view class="verdict-hero {{res.danger ? 'danger' : 'safe'}}">
      <view class="result-kicker">{{res.danger ? 'HIGH RISK MESSAGE' : 'LOW RISK MESSAGE'}}</view>
      <view class="verdict-word">{{res.verdict}}</view>
      <view wx:if="{{res.type_note}}" class="verdict-note">{{res.type_note}}</view>
    </view>

    <view wx:if="{{res.danger}}" class="risk-grid">
      <view><text>会触发</text><view>{{res.trigger}}</view></view>
      <view><text>Ta 可能会</text><view>{{res.prediction}}</view></view>
    </view>

    <view class="alternative-block">
      <view class="result-section-label">{{res.danger ? 'SEND THIS INSTEAD' : 'WHY IT WORKS'}}</view>
      <view wx:if="{{res.danger}}" class="alternative-text">「{{res.alternative}}」</view>
      <view class="result-copy">{{res.reason}}</view>
    </view>

    <view class="result-action-grid">
      <button class="result-action" bindtap="resetInput">重新检测</button>
      <button class="result-action" bindtap="copyResult">复制结果</button>
      <button class="result-action dark" open-type="share">分享</button>
    </view>
    <view class="disclaimer">发送建议只基于当前文本和所选类型，不代表对方一定会这样反应。</view>
  </view>

  <view wx:if="{{step === 'result' && res && isReplyMode}}" class="fu">
    <view class="result-lead">
      <view class="result-kicker">REPLY STRATEGY</view>
      <view class="result-title"><view>别急着赢</view><view>先把话说清楚</view></view>
      <view class="result-copy">{{res.strategy}}</view>
    </view>

    <view wx:for="{{res.drafts}}" wx:key="label" class="reply-row">
      <view class="reply-head"><text>{{item.label}}</text><text>可直接发</text></view>
      <view class="reply-text">「{{item.text}}」</view>
      <view class="reply-why">{{item.why}}</view>
    </view>

    <view class="avoid-block">
      <view class="result-section-label">DO NOT SEND</view>
      <view>{{res.avoid}}</view>
    </view>
    <view wx:if="{{res.note}}" class="type-note"><text>类型提醒</text><view>{{res.note}}</view></view>

    <view class="result-action-grid">
      <button class="result-action" bindtap="resetInput">重新生成</button>
      <button class="result-action" bindtap="copyResult">复制回复</button>
      <button class="result-action dark" open-type="share">分享</button>
    </view>
    <view class="disclaimer">回复建议基于你提供的背景生成。别为了显得体面而憋死自己，也别为了爽一下把局面炸了。</view>
  </view>
</view>
