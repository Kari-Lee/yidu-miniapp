<view class="profiles-page">
  <view style="height: {{statusBarHeight}}px"></view>

  <view class="profiles-topbar">
    <text class="profiles-back" bindtap="goBack">← 返回</text>
    <text class="profiles-create" bindtap="toggleForm">{{showForm ? '收起' : '新建档案'}}</text>
  </view>

  <view class="profiles-head">
    <view class="profiles-kicker">RELATION FILES</view>
    <view class="profiles-title">关系档案</view>
    <view class="profiles-subtitle">前任和暧昧对象分开管理，别让Ta们之间相互污染</view>
  </view>

  <view class="privacy-note">
    <view class="privacy-title">只保存在本机</view>
    <view class="privacy-copy">档案只用于带入关系背景。只有你在分析页主动提交的内容，才会发送给 AI。</view>
  </view>

  <view wx:if="{{showForm}}" class="profile-editor">
    <view class="editor-kicker">{{editingId ? 'EDIT PROFILE' : 'NEW PROFILE'}}</view>
    <view class="editor-title">{{editingId ? '编辑 Ta 的档案' : '新建 Ta 的档案'}}</view>

    <input
      class="profile-input"
      placeholder="Ta 是谁？比如：小王 / 前任 / 那个不回消息的人"
      placeholder-style="color:#B8BDC8"
      value="{{form.name}}"
      bindinput="onNameInput"
    />

    <view class="field-title">你们的关系</view>
    <view class="chip-row">
      <view
        wx:for="{{relationOptions}}"
        wx:key="index"
        class="chip {{form.relation === item ? 'chip-active' : ''}}"
        data-relation="{{item}}"
        bindtap="pickRelation"
      >{{item}}</view>
    </view>

    <view class="field-title">Ta 的疑似依恋类型</view>
    <view class="chip-row">
      <view
        wx:for="{{typeOptions}}"
        wx:key="key"
        class="chip {{form.type === item.key ? 'chip-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="pickType"
      >{{item.label}}</view>
    </view>

    <textarea
      class="profile-textarea"
      auto-height
      maxlength="-1"
      placeholder="补充认识多久、最近卡在哪里，或任何需要记住的背景……"
      placeholder-style="color:#B8BDC8"
      value="{{form.note}}"
      bindinput="onNoteInput"
    ></textarea>

    <view class="editor-actions">
      <view class="editor-cancel" bindtap="resetForm">取消</view>
      <view class="editor-save" bindtap="saveProfile">{{editingId ? '更新档案' : '保存档案'}} ↗</view>
    </view>
  </view>

  <view wx:if="{{!profiles.length && !showForm}}" class="profiles-empty">
    <view class="empty-no">00</view>
    <view class="empty-title">还没有关系档案</view>
    <view class="empty-copy">先建一个 Ta，以后分析时就不必反复交代背景。</view>
    <view class="empty-action" bindtap="toggleForm">新建第一个档案 ↗</view>
  </view>

  <view wx:if="{{profiles.length}}" class="profiles-list-head">
    <text>YOUR RELATIONS</text>
    <text>{{profiles.length}} 个档案</text>
  </view>

  <view
    wx:for="{{profiles}}"
    wx:key="id"
    class="profile-sheet"
    data-id="{{item.id}}"
    bindtap="goDetail"
  >
    <view class="profile-meta">
      <view class="relation-label">{{item.relation}}</view>
      <view class="profile-time">{{item.timeText}}</view>
    </view>

    <view class="profile-name">{{item.name}}</view>
    <view class="profile-type">
      <text>疑似类型</text>
      <view>{{item.typeLabel || '未知'}}</view>
    </view>

    <view wx:if="{{item.note}}" class="profile-note">{{item.note}}</view>

    <view wx:if="{{item.latest}}" class="latest-block">
      <view class="latest-meta">最近分析 · {{item.latest.kindLabel}} · {{item.latest.timeText}}</view>
      <view class="latest-title">{{item.latest.title}}</view>
    </view>

    <view class="profile-detail-link">
      <text>查看完整档案</text>
      <text>↗</text>
    </view>

    <view class="profile-tools">
      <view catchtap="goDiagnose" data-id="{{item.id}}">聊天确诊</view>
      <view catchtap="goCheck" data-id="{{item.id}}">发不发</view>
      <view catchtap="goPredict" data-id="{{item.id}}">感情预测</view>
    </view>

    <view class="profile-manage">
      <text catchtap="editProfile" data-id="{{item.id}}">编辑档案</text>
      <text class="danger" catchtap="deleteProfile" data-id="{{item.id}}">删除</text>
    </view>
  </view>
</view>
