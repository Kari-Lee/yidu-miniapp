.hero-card {
  padding: 44rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 40rpx rgba(0,0,0,0.04);
  margin-bottom: 24rpx;
}

.pill {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #F8FAFB;
  color: #B8860B;
  font-size: 22rpx;
  font-weight: 900;
}

.pill.warm {
  background: rgba(184,134,11,0.08);
}

.type-line {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 900;
}

.note-block {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 24rpx;
  background: #F8FAFB;
  color: rgba(26,26,46,0.76);
  font-size: 25rpx;
  line-height: 1.8;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.quick-grid button {
  min-height: 132rpx;
  padding: 22rpx 8rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  color: #2D3436;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 0 4rpx 30rpx rgba(0,0,0,0.04);
}

.quick-grid button text {
  display: block;
  font-size: 36rpx;
  margin-bottom: 8rpx;
}

.quick-grid button::after {
  border: none;
}

.latest-card {
  padding: 40rpx;
}

.section-title {
  color: #8395A7;
  font-size: 24rpx;
  font-weight: 900;
  margin-bottom: 18rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 4rpx 18rpx;
}

.empty-card {
  padding: 52rpx 36rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  text-align: center;
  box-shadow: 0 4rpx 32rpx rgba(0,0,0,0.04);
}

.timeline-card {
  position: relative;
  display: flex;
  gap: 22rpx;
  padding: 28rpx 0 28rpx 8rpx;
  border-bottom: 2rpx solid rgba(0,0,0,0.04);
}

.dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #B8860B;
  margin-top: 20rpx;
  box-shadow: 0 0 0 10rpx rgba(184,134,11,0.08);
  flex-shrink: 0;
}
