.profile-page {
  min-height: 100vh;
  padding: 0 36rpx 120rpx;
  box-sizing: border-box;
  background: #F3F4F8;
  overflow-x: hidden;
}

.profile-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  border-bottom: 2rpx solid rgba(45,47,51,0.07);
}

.profile-back,
.profile-edit {
  color: #2D2F33;
  font-size: 25rpx;
  font-weight: 900;
}

.profile-edit {
  color: #10A8E8;
}

.profile-content {
  animation: profile-rise 0.3s ease both;
}

.profile-hero {
  padding: 48rpx 4rpx 44rpx;
}

.profile-kicker,
.section-heading text {
  color: #10A8E8;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.hero-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 30rpx;
  color: rgba(45,47,51,0.42);
  font-size: 21rpx;
  font-weight: 800;
}

.hero-meta text:first-child {
  color: #2D2F33;
}

.hero-name {
  margin-top: 16rpx;
  color: #2D2F33;
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1.08;
  overflow-wrap: anywhere;
}

.type-panel {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28rpx;
  margin-top: 38rpx;
  padding: 28rpx 0;
  border-top: 2rpx solid rgba(45,47,51,0.08);
  border-bottom: 2rpx solid rgba(45,47,51,0.08);
}

.type-label,
.note-label {
  color: rgba(45,47,51,0.4);
  font-size: 20rpx;
  font-weight: 900;
}

.type-name {
  margin-top: 7rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.type-desc {
  max-width: 58%;
  color: rgba(45,47,51,0.56);
  font-size: 22rpx;
  line-height: 1.65;
  text-align: right;
}

.profile-note {
  margin-top: 26rpx;
  padding: 24rpx 26rpx;
  border-left: 5rpx solid #10A8E8;
  background: rgba(255,255,255,0.58);
  color: rgba(45,47,51,0.68);
  font-size: 24rpx;
  line-height: 1.72;
}

.note-label {
  margin-bottom: 8rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin: 18rpx 4rpx 16rpx;
}

.section-heading view {
  color: rgba(45,47,51,0.44);
  font-size: 21rpx;
  text-align: right;
}

.action-heading {
  margin-top: 28rpx;
}

.profile-followup-card {
  margin: 0 0 28rpx;
  padding: 30rpx 28rpx 0;
  border-left: 6rpx solid #E17055;
  background: #FFFFFF;
}

.profile-followup-head,
.profile-followup-link,
.profile-followup-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.profile-followup-head {
  color: #B8BDC8;
  font-size: 20rpx;
  font-weight: 800;
}

.profile-followup-head text {
  color: #E17055;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.profile-followup-title {
  margin-top: 16rpx;
  color: #2D2F33;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1.3;
}

.profile-followup-copy {
  margin-top: 10rpx;
  color: rgba(45,47,51,0.58);
  font-size: 23rpx;
  line-height: 1.66;
}

.profile-followup-actions {
  margin-top: 24rpx;
}

.profile-followup-actions view {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 72rpx;
  background: #F3F4F8;
  color: #2D2F33;
  font-size: 23rpx;
  font-weight: 900;
  text-align: center;
}

.profile-followup-actions view:first-child {
  background: #2D2F33;
  color: #FFFFFF;
}

.profile-followup-link {
  min-height: 78rpx;
  margin-top: 22rpx;
  border-top: 2rpx solid rgba(45,47,51,0.08);
  color: rgba(45,47,51,0.6);
  font-size: 22rpx;
  font-weight: 900;
}

.profile-followup-link text:last-child {
  color: #10A8E8;
  font-size: 30rpx;
}

.weekly-card {
  padding: 30rpx 28rpx 28rpx;
  border-left: 6rpx solid rgba(45,47,51,0.16);
  background: #FFFFFF;
}

.weekly-card.ready {
  border-left-color: #10A8E8;
}

.weekly-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
}

.weekly-kicker {
  color: #10A8E8;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.weekly-title {
  margin-top: 12rpx;
  color: #2D2F33;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.28;
}

.weekly-count {
  flex-shrink: 0;
  min-width: 92rpx;
  padding-top: 2rpx;
  color: #B8BDC8;
  font-size: 34rpx;
  font-weight: 900;
  text-align: right;
}

.weekly-card.ready .weekly-count {
  color: #10A8E8;
}

.weekly-verdict {
  margin-top: 22rpx;
  color: #2D2F33;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.5;
}

.weekly-copy,
.weekly-advice {
  margin-top: 10rpx;
  color: rgba(45,47,51,0.58);
  font-size: 23rpx;
  line-height: 1.68;
}

.weekly-progress {
  height: 7rpx;
  margin-top: 24rpx;
  background: rgba(45,47,51,0.08);
  overflow: hidden;
}

.weekly-progress view {
  height: 100%;
  background: #10A8E8;
}

.weekly-stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  margin-top: 24rpx;
  border-top: 2rpx solid rgba(45,47,51,0.08);
  border-left: 2rpx solid rgba(45,47,51,0.08);
}

.weekly-stats > view {
  min-height: 92rpx;
  padding: 14rpx 12rpx;
  border-right: 2rpx solid rgba(45,47,51,0.08);
  border-bottom: 2rpx solid rgba(45,47,51,0.08);
  box-sizing: border-box;
}

.weekly-stats text {
  display: block;
  color: rgba(45,47,51,0.42);
  font-size: 18rpx;
  font-weight: 900;
}

.weekly-stats view view {
  margin-top: 8rpx;
  color: #2D2F33;
  font-size: 24rpx;
  font-weight: 900;
  line-height: 1.25;
}

.weekly-advice {
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(45,47,51,0.08);
}

.weekly-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  min-height: 72rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(45,47,51,0.08);
  color: #2D2F33;
  font-size: 23rpx;
  font-weight: 900;
}

.weekly-link text:last-child {
  color: #10A8E8;
  font-size: 30rpx;
}

.today-card {
  position: relative;
  padding: 28rpx 28rpx 26rpx;
  border-left: 6rpx solid #10A8E8;
  background: #FFFFFF;
  overflow: hidden;
}

.today-kicker {
  position: relative;
  z-index: 1;
  color: #10A8E8;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.today-title {
  position: relative;
  z-index: 1;
  margin-top: 14rpx;
  color: #2D2F33;
  font-size: 34rpx;
  font-weight: 900;
  line-height: 1.34;
}

.today-copy {
  position: relative;
  z-index: 1;
  width: 100%;
  margin-top: 10rpx;
  color: rgba(45,47,51,0.56);
  font-size: 23rpx;
  line-height: 1.62;
}

.today-action {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 78rpx;
  margin-top: 22rpx;
  padding: 0 24rpx;
  background: #2D2F33;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.today-action text:last-child {
  color: #10A8E8;
  font-size: 30rpx;
}

.start-card {
  padding: 34rpx 30rpx 28rpx;
  border-left: 6rpx solid #10A8E8;
  background: #FFFFFF;
}

.start-kicker {
  color: #10A8E8;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.start-title {
  margin-top: 16rpx;
  color: #2D2F33;
  font-size: 38rpx;
  font-weight: 900;
  line-height: 1.3;
}

.start-copy {
  margin-top: 14rpx;
  color: rgba(45,47,51,0.58);
  font-size: 23rpx;
  line-height: 1.68;
}

.start-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  min-height: 82rpx;
  margin-top: 28rpx;
  padding: 0 24rpx;
  background: #2D2F33;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.start-action text:last-child {
  color: #10A8E8;
  font-size: 30rpx;
}

.start-progress {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 22rpx;
  color: rgba(45,47,51,0.42);
  font-size: 20rpx;
  font-weight: 900;
}

.start-progress > view {
  flex: 1;
  height: 6rpx;
  background: rgba(45,47,51,0.08);
  overflow: hidden;
}

.start-progress > view view {
  height: 100%;
  background: #10A8E8;
}

.analysis-list {
  background: #FFFFFF;
}

.analysis-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  min-height: 108rpx;
  padding: 0 26rpx;
  border-bottom: 2rpx solid rgba(45,47,51,0.07);
  box-sizing: border-box;
}

.analysis-row:last-child {
  border-bottom: none;
}

.analysis-copy {
  flex: 1;
  min-width: 0;
}

.analysis-title {
  color: #2D2F33;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.34;
}

.analysis-desc {
  margin-top: 6rpx;
  color: rgba(45,47,51,0.46);
  font-size: 20rpx;
  font-weight: 800;
}

.analysis-arrow,
.timeline-arrow {
  flex-shrink: 0;
  color: #2D2F33;
  font-size: 30rpx;
  font-weight: 900;
}

.minor-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 12rpx;
}

.minor-actions view {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 72rpx;
  background: #FFFFFF;
  color: rgba(45,47,51,0.58);
  font-size: 22rpx;
  font-weight: 900;
  text-align: center;
}

.minor-actions .dark {
  background: #2D2F33;
  color: #FFFFFF;
}

.history-section {
  margin-top: 34rpx;
}

.history-heading {
  margin-top: 34rpx;
}

.latest-sheet {
  padding: 32rpx 30rpx 0;
  border-top: 6rpx solid #10A8E8;
  background: #FFFFFF;
}

.latest-meta,
.timeline-meta,
.latest-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.latest-meta {
  color: #B8BDC8;
  font-size: 20rpx;
}

.latest-meta text:first-child {
  color: #10A8E8;
  font-weight: 900;
}

.latest-title {
  margin-top: 22rpx;
  color: #2D2F33;
  font-size: 35rpx;
  font-weight: 900;
  line-height: 1.42;
}

.latest-summary {
  margin-top: 14rpx;
  color: rgba(45,47,51,0.6);
  font-size: 24rpx;
  line-height: 1.72;
}

.latest-link {
  min-height: 82rpx;
  margin-top: 24rpx;
  border-top: 2rpx solid rgba(45,47,51,0.08);
  color: #2D2F33;
  font-size: 23rpx;
  font-weight: 900;
}

.empty-history {
  position: relative;
  padding: 28rpx 30rpx;
  border-left: 6rpx solid rgba(45,47,51,0.12);
  background: #FFFFFF;
  overflow: hidden;
}

.empty-no,
.missing-no {
  position: absolute;
  top: -34rpx;
  right: 8rpx;
  color: transparent;
  -webkit-text-stroke: 2rpx rgba(45,47,51,0.08);
  font-size: 150rpx;
  font-weight: 900;
  line-height: 1;
}

.empty-title,
.missing-title {
  position: relative;
  color: #2D2F33;
  font-size: 30rpx;
  font-weight: 900;
}

.empty-copy,
.missing-copy {
  position: relative;
  width: 100%;
  margin-top: 12rpx;
  color: rgba(45,47,51,0.52);
  font-size: 23rpx;
  line-height: 1.7;
}

.empty-action {
  margin-top: 30rpx;
  padding: 24rpx;
  color: #FFFFFF;
  background: #2D2F33;
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
}

.timeline-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 28rpx 4rpx;
  border-top: 2rpx solid rgba(45,47,51,0.08);
}

.timeline-index {
  width: 40rpx;
  flex-shrink: 0;
  color: #B8BDC8;
  font-size: 18rpx;
  font-weight: 900;
}

.timeline-content {
  flex: 1;
  min-width: 0;
}

.timeline-meta {
  color: #B8BDC8;
  font-size: 19rpx;
}

.timeline-meta text:first-child {
  color: #10A8E8;
  font-weight: 900;
}

.timeline-title {
  margin-top: 12rpx;
  color: #2D2F33;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.45;
}

.timeline-summary {
  margin-top: 8rpx;
  color: rgba(45,47,51,0.56);
  font-size: 22rpx;
  line-height: 1.68;
}

.timeline-images {
  margin-top: 10rpx;
  color: #10A8E8;
  font-size: 20rpx;
  font-weight: 900;
}

.timeline-arrow {
  margin-top: 30rpx;
}

.missing-profile {
  position: relative;
  margin-top: 46rpx;
  padding: 60rpx 34rpx;
  border-top: 6rpx solid #10A8E8;
  background: #FFFFFF;
  overflow: hidden;
}

@keyframes profile-rise {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
