.profile-page {
  min-height: 100vh;
  padding: 0 36rpx 120rpx;
  box-sizing: border-box;
  background: #F3F4F8;
  overflow-x: hidden;
}

.profile-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 76rpx;
  border-bottom: 2rpx solid rgba(45,47,51,0.07);
}

.profile-back,
.profile-edit {
  color: #2D2F33;
  font-size: 25rpx;
  font-weight: 900;
}

.profile-edit {
  color: #10A8E8;
}

.profile-content {
  animation: profile-rise 0.3s ease both;
}

.profile-hero {
  padding: 48rpx 4rpx 44rpx;
}

.profile-kicker,
.section-heading text {
  color: #10A8E8;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.hero-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 30rpx;
  color: rgba(45,47,51,0.42);
  font-size: 21rpx;
  font-weight: 800;
}

.hero-meta text:first-child {
  color: #2D2F33;
}

.hero-name {
  margin-top: 16rpx;
  color: #2D2F33;
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1.08;
  overflow-wrap: anywhere;
}

.type-panel {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 28rpx;
  margin-top: 38rpx;
  padding: 28rpx 0;
  border-top: 2rpx solid rgba(45,47,51,0.08);
  border-bottom: 2rpx solid rgba(45,47,51,0.08);
}

.type-label,
.note-label {
  color: rgba(45,47,51,0.4);
  font-size: 20rpx;
  font-weight: 900;
}

.type-name {
  margin-top: 7rpx;
  font-size: 30rpx;
  font-weight: 900;
}

.type-desc {
  max-width: 58%;
  color: rgba(45,47,51,0.56);
  font-size: 22rpx;
  line-height: 1.65;
  text-align: right;
}

.profile-note {
  margin-top: 26rpx;
  padding: 24rpx 26rpx;
  border-left: 5rpx solid #10A8E8;
  background: rgba(255,255,255,0.58);
  color: rgba(45,47,51,0.68);
  font-size: 24rpx;
  line-height: 1.72;
}

.note-label {
  margin-bottom: 8rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
  margin: 22rpx 4rpx 18rpx;
}

.section-heading view {
  color: rgba(45,47,51,0.44);
  font-size: 21rpx;
  text-align: right;
}

.quick-tools {
  border-top: 2rpx solid rgba(45,47,51,0.09);
}

.tool-entry {
  display: flex;
  align-items: center;
  gap: 22rpx;
  min-height: 116rpx;
  padding: 0 24rpx;
  border-bottom: 2rpx solid rgba(45,47,51,0.09);
  box-sizing: border-box;
  background: #FFFFFF;
}

.tool-entry-dark {
  border-bottom-color: rgba(255,255,255,0.12);
  background: #2D2F33;
}

.tool-no {
  width: 44rpx;
  flex-shrink: 0;
  color: #B8BDC8;
  font-size: 18rpx;
  font-weight: 900;
}

.tool-entry-dark .tool-no {
  color: #10A8E8;
}

.tool-copy {
  flex: 1;
  min-width: 0;
}

.tool-title {
  color: #2D2F33;
  font-size: 29rpx;
  font-weight: 900;
}

.tool-desc {
  margin-top: 6rpx;
  color: rgba(45,47,51,0.48);
  font-size: 21rpx;
}

.tool-entry-dark .tool-title {
  color: #FFFFFF;
}

.tool-entry-dark .tool-desc {
  color: rgba(255,255,255,0.46);
}

.tool-arrow,
.timeline-arrow {
  flex-shrink: 0;
  color: #2D2F33;
  font-size: 30rpx;
  font-weight: 900;
}

.tool-entry-dark .tool-arrow {
  color: #FFFFFF;
}

.history-section {
  margin-top: 44rpx;
}

.history-heading {
  margin-top: 44rpx;
}

.latest-sheet {
  padding: 32rpx 30rpx 0;
  border-top: 6rpx solid #10A8E8;
  background: #FFFFFF;
}

.latest-meta,
.timeline-meta,
.latest-link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.latest-meta {
  color: #B8BDC8;
  font-size: 20rpx;
}

.latest-meta text:first-child {
  color: #10A8E8;
  font-weight: 900;
}

.latest-title {
  margin-top: 22rpx;
  color: #2D2F33;
  font-size: 35rpx;
  font-weight: 900;
  line-height: 1.42;
}

.latest-summary {
  margin-top: 14rpx;
  color: rgba(45,47,51,0.6);
  font-size: 24rpx;
  line-height: 1.72;
}

.latest-link {
  min-height: 82rpx;
  margin-top: 24rpx;
  border-top: 2rpx solid rgba(45,47,51,0.08);
  color: #2D2F33;
  font-size: 23rpx;
  font-weight: 900;
}

.empty-history {
  position: relative;
  padding: 48rpx 30rpx 30rpx;
  border-top: 6rpx solid #10A8E8;
  background: #FFFFFF;
  overflow: hidden;
}

.empty-no,
.missing-no {
  position: absolute;
  top: -34rpx;
  right: 8rpx;
  color: transparent;
  -webkit-text-stroke: 2rpx rgba(45,47,51,0.08);
  font-size: 150rpx;
  font-weight: 900;
  line-height: 1;
}

.empty-title,
.missing-title {
  position: relative;
  color: #2D2F33;
  font-size: 34rpx;
  font-weight: 900;
}

.empty-copy,
.missing-copy {
  position: relative;
  width: 82%;
  margin-top: 12rpx;
  color: rgba(45,47,51,0.52);
  font-size: 23rpx;
  line-height: 1.7;
}

.empty-action {
  margin-top: 30rpx;
  padding: 24rpx;
  color: #FFFFFF;
  background: #2D2F33;
  font-size: 24rpx;
  font-weight: 900;
  text-align: center;
}

.timeline-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 28rpx 4rpx;
  border-top: 2rpx solid rgba(45,47,51,0.08);
}

.timeline-index {
  width: 40rpx;
  flex-shrink: 0;
  color: #B8BDC8;
  font-size: 18rpx;
  font-weight: 900;
}

.timeline-content {
  flex: 1;
  min-width: 0;
}

.timeline-meta {
  color: #B8BDC8;
  font-size: 19rpx;
}

.timeline-meta text:first-child {
  color: #10A8E8;
  font-weight: 900;
}

.timeline-title {
  margin-top: 12rpx;
  color: #2D2F33;
  font-size: 28rpx;
  font-weight: 900;
  line-height: 1.45;
}

.timeline-summary {
  margin-top: 8rpx;
  color: rgba(45,47,51,0.56);
  font-size: 22rpx;
  line-height: 1.68;
}

.timeline-images {
  margin-top: 10rpx;
  color: #10A8E8;
  font-size: 20rpx;
  font-weight: 900;
}

.timeline-arrow {
  margin-top: 30rpx;
}

.missing-profile {
  position: relative;
  margin-top: 46rpx;
  padding: 60rpx 34rpx;
  border-top: 6rpx solid #10A8E8;
  background: #FFFFFF;
  overflow: hidden;
}

@keyframes profile-rise {
  from {
    opacity: 0;
    transform: translateY(12rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
