<view class="profile-page">
  <view style="height: {{statusBarHeight}}px"></view>

  <view class="profile-topbar">
    <text class="profile-back" bindtap="goBack">← 返回</text>
    <text wx:if="{{profile}}" class="profile-edit" bindtap="goEdit">编辑档案</text>
  </view>

  <view wx:if="{{!profile}}" class="missing-profile">
    <view class="missing-no">404</view>
    <view class="missing-title">档案找不到了</view>
    <view class="missing-copy">可能已经被删除，或者本机缓存被清理。</view>
  </view>

  <view wx:if="{{profile}}" class="profile-content">
    <view class="profile-hero">
      <view class="profile-kicker">RELATION FILE</view>
      <view class="hero-meta">
        <text>{{profile.relation}}</text>
        <text>{{profile.timeText}}</text>
      </view>
      <view class="hero-name">{{profile.name}}</view>

      <view class="type-panel">
        <view>
          <view class="type-label">疑似依恋类型</view>
          <view class="type-name" style="color: {{typeInfo.color}};">{{profile.typeLabel || typeInfo.label}}</view>
        </view>
        <view class="type-desc">{{typeInfo.desc}}</view>
      </view>

      <view wx:if="{{profile.note}}" class="profile-note">
        <view class="note-label">关系备注</view>
        <view>{{profile.note}}</view>
      </view>
    </view>

    <view wx:if="{{hasRecords}}" class="section-heading">
      <text>7-DAY REPORT</text>
      <view>{{weeklyReport.ready ? '本周趋势' : '生成进度'}}</view>
    </view>

    <view wx:if="{{hasRecords}}" class="weekly-card {{weeklyReport.ready ? 'ready' : ''}}">
      <view class="weekly-top">
        <view>
          <view class="weekly-kicker">{{weeklyReport.ready ? 'RELATION TREND' : 'REPORT PROGRESS'}}</view>
          <view class="weekly-title">{{weeklyReport.status}}</view>
        </view>
        <view class="weekly-count">{{weeklyReport.total}}/3</view>
      </view>
      <view class="weekly-verdict">{{weeklyReport.verdict}}</view>
      <view class="weekly-copy">{{weeklyReport.trend}}</view>
      <view class="weekly-progress">
        <view style="width: {{weeklyReport.progress}}%;"></view>
      </view>
      <view wx:if="{{weeklyReport.ready}}" class="weekly-stats">
        <view><text>主线</text><view>{{weeklyReport.mainKind}}</view></view>
        <view><text>已发</text><view>{{weeklyReport.sent}}</view></view>
        <view><text>有效回应</text><view>{{weeklyReport.replied}}</view></view>
        <view><text>弱回应</text><view>{{weeklyReport.weak}}</view></view>
      </view>
      <view class="weekly-advice">{{weeklyReport.advice}}</view>
    </view>

    <view wx:if="{{hasRecords}}" class="section-heading action-heading">
      <text>TODAY</text>
      <view>继续补充材料</view>
    </view>

    <view wx:if="{{hasRecords}}" class="today-card">
      <view class="today-kicker">{{todayPlan.kicker}}</view>
      <view class="today-title">{{todayPlan.title}}</view>
      <view class="today-copy">{{todayPlan.copy}}</view>
      <view class="today-action" bindtap="goTodayAction">
        <text>{{todayPlan.actionLabel}}</text>
        <text>↗</text>
      </view>
    </view>

    <view wx:if="{{!hasRecords}}" class="start-card">
      <view class="start-kicker">START FILE</view>
      <view class="start-title">先给这段关系留第一条记录</view>
      <view class="start-copy">七日关系报告需要 3 条记录。先上传一段聊天，或从一句话开始，后面再看趋势。</view>
      <view class="start-action" bindtap="goTodayAction">
        <text>{{todayPlan.actionLabel}}</text>
        <text>↗</text>
      </view>
      <view class="start-progress">
        <text>周报进度</text>
        <view><view style="width: {{weeklyReport.progress}}%;"></view></view>
        <text>{{weeklyReport.total}}/3</text>
      </view>
    </view>

    <view class="section-heading action-heading">
      <text>CONTINUE</text>
      <view>{{hasRecords ? '常用分析' : '也可以从这里开始'}}</view>
    </view>

    <view class="analysis-list">
      <view class="analysis-row" bindtap="goTranslate">
        <view class="analysis-copy">
          <view class="analysis-title">Ta 这句话什么意思</view>
          <view class="analysis-desc">翻译潜台词</view>
        </view>
        <view class="analysis-arrow">↗</view>
      </view>
      <view class="analysis-row" bindtap="goCheck">
        <view class="analysis-copy">
          <view class="analysis-title">我这句能不能发</view>
          <view class="analysis-desc">检查发送风险</view>
        </view>
        <view class="analysis-arrow">↗</view>
      </view>
      <view class="analysis-row" bindtap="goReply">
        <view class="analysis-copy">
          <view class="analysis-title">帮我回一句</view>
          <view class="analysis-desc">生成下一句</view>
        </view>
        <view class="analysis-arrow">↗</view>
      </view>
    </view>

    <view class="minor-actions">
      <view bindtap="goDiagnose">聊天截图</view>
      <view bindtap="goPredict">关系走向</view>
      <view class="dark" bindtap="goMisread">已读乱回</view>
    </view>

    <view wx:if="{{latest}}" class="history-section">
      <view class="section-heading history-heading">
        <text>LATEST RECORD</text>
        <view>最近一次分析</view>
      </view>

      <view class="latest-sheet" data-id="{{latest.id}}" bindtap="openHistory">
        <view class="latest-meta">
          <text>{{latest.kindLabel}}</text>
          <text>{{latest.timeText}}</text>
        </view>
        <view class="latest-title">{{latest.title}}</view>
        <view class="latest-summary">{{latest.summary}}</view>
        <view class="latest-link">
          <text>查看完整结果</text>
          <text>↗</text>
        </view>
      </view>
    </view>

    <view wx:if="{{hasRecords}}" class="section-heading history-heading">
      <text>PRIVATE HISTORY</text>
      <view>专属历史 · {{records.length}} 条</view>
    </view>

    <view
      wx:for="{{records}}"
      wx:key="id"
      class="timeline-row"
      data-id="{{item.id}}"
      bindtap="openHistory"
    >
      <view class="timeline-index">{{index < 9 ? '0' + (index + 1) : index + 1}}</view>
      <view class="timeline-content">
        <view class="timeline-meta">
          <text>{{item.kindLabel}}</text>
          <text>{{item.timeText}}</text>
        </view>
        <view class="timeline-title">{{item.title}}</view>
        <view class="timeline-summary">{{item.summary}}</view>
        <view wx:if="{{item.imageCount}}" class="timeline-images">含 {{item.imageCount}} 张截图</view>
      </view>
      <view class="timeline-arrow">↗</view>
    </view>
  </view>
</view>
