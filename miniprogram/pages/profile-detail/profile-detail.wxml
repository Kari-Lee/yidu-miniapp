<view class="profile-page">
  <view style="height: {{statusBarHeight}}px"></view>

  <view class="profile-topbar">
    <text class="profile-back" bindtap="goBack">← 返回</text>
    <text wx:if="{{profile}}" class="profile-edit" bindtap="goEdit">编辑档案</text>
  </view>

  <view wx:if="{{!profile}}" class="missing-profile">
    <view class="missing-no">404</view>
    <view class="missing-title">档案找不到了</view>
    <view class="missing-copy">可能已经被删除，或者本机缓存被清理。</view>
  </view>

  <view wx:if="{{profile}}" class="profile-content">
    <view class="profile-hero">
      <view class="profile-kicker">RELATION FILE</view>
      <view class="hero-meta">
        <text>{{profile.relation}}</text>
        <text>{{profile.timeText}}</text>
      </view>
      <view class="hero-name">{{profile.name}}</view>

      <view class="type-panel">
        <view>
          <view class="type-label">疑似依恋类型</view>
          <view class="type-name" style="color: {{typeInfo.color}};">{{profile.typeLabel || typeInfo.label}}</view>
        </view>
        <view class="type-desc">{{typeInfo.desc}}</view>
      </view>

      <view wx:if="{{profile.note}}" class="profile-note">
        <view class="note-label">关系备注</view>
        <view>{{profile.note}}</view>
      </view>
    </view>

    <view class="section-heading">
      <text>QUICK TOOLS</text>
      <view>带着这个 Ta 的档案继续分析</view>
    </view>

    <view class="quick-tools">
      <view class="tool-entry tool-entry-dark" bindtap="goDiagnose">
        <view class="tool-no">01</view>
        <view class="tool-copy">
          <view class="tool-title">聊天确诊</view>
          <view class="tool-desc">上传聊天，看双方的依恋模式</view>
        </view>
        <view class="tool-arrow">↗</view>
      </view>
      <view class="tool-entry" bindtap="goCheck">
        <view class="tool-no">02</view>
        <view class="tool-copy">
          <view class="tool-title">发不发</view>
          <view class="tool-desc">发送之前，先看会触发什么</view>
        </view>
        <view class="tool-arrow">↗</view>
      </view>
      <view class="tool-entry" bindtap="goPredict">
        <view class="tool-no">03</view>
        <view class="tool-copy">
          <view class="tool-title">感情预测</view>
          <view class="tool-desc">根据互动模式推演关系走向</view>
        </view>
        <view class="tool-arrow">↗</view>
      </view>
    </view>

    <view wx:if="{{latest}}" class="history-section">
      <view class="section-heading history-heading">
        <text>LATEST RECORD</text>
        <view>最近一次分析</view>
      </view>

      <view class="latest-sheet" data-id="{{latest.id}}" bindtap="openHistory">
        <view class="latest-meta">
          <text>{{latest.kindLabel}}</text>
          <text>{{latest.timeText}}</text>
        </view>
        <view class="latest-title">{{latest.title}}</view>
        <view class="latest-summary">{{latest.summary}}</view>
        <view class="latest-link">
          <text>查看完整结果</text>
          <text>↗</text>
        </view>
      </view>
    </view>

    <view class="section-heading history-heading">
      <text>PRIVATE HISTORY</text>
      <view>专属历史 · {{records.length}} 条</view>
    </view>

    <view wx:if="{{!records.length}}" class="empty-history">
      <view class="empty-no">00</view>
      <view class="empty-title">还没有这个人的分析</view>
      <view class="empty-copy">完成一次聊天确诊后，记录会自动归到这里。</view>
      <view class="empty-action" bindtap="goDiagnose">开始第一次分析 ↗</view>
    </view>

    <view
      wx:for="{{records}}"
      wx:key="id"
      class="timeline-row"
      data-id="{{item.id}}"
      bindtap="openHistory"
    >
      <view class="timeline-index">{{index < 9 ? '0' + (index + 1) : index + 1}}</view>
      <view class="timeline-content">
        <view class="timeline-meta">
          <text>{{item.kindLabel}}</text>
          <text>{{item.timeText}}</text>
        </view>
        <view class="timeline-title">{{item.title}}</view>
        <view class="timeline-summary">{{item.summary}}</view>
        <view wx:if="{{item.imageCount}}" class="timeline-images">含 {{item.imageCount}} 张截图</view>
      </view>
      <view class="timeline-arrow">↗</view>
    </view>
  </view>
</view>
