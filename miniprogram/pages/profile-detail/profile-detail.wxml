<view class="container" style="padding: 0 32rpx 120rpx;">
  <view style="height: {{statusBarHeight}}px"></view>
  <view style="padding: 24rpx 0; display: flex; align-items: center; justify-content: space-between;">
    <text bindtap="goBack" style="font-size: 24rpx; color: #B8860B; font-weight: 600;">‹ 返回</text>
    <text wx:if="{{profile}}" bindtap="goEdit" style="font-size: 24rpx; color: #B8860B; font-weight: 800;">编辑</text>
  </view>

  <view wx:if="{{!profile}}" class="card" style="text-align: center; padding: 80rpx 40rpx;">
    <view style="font-size: 72rpx; margin-bottom: 20rpx;">🫥</view>
    <view class="serif" style="font-size: 34rpx; font-weight: 800; color: #1A1A2E;">档案找不到了</view>
    <view style="font-size: 26rpx; color: #8395A7; margin-top: 12rpx;">可能已经被删除，或者本机缓存被清理</view>
  </view>

  <view wx:if="{{profile}}" class="fu">
    <view class="hero-card">
      <view style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx;">
        <view class="pill">{{profile.relation}}</view>
        <view style="font-size: 22rpx; color: #C8D6E5;">{{profile.timeText}}</view>
      </view>
      <view class="serif" style="font-size: 58rpx; font-weight: 900; color: #1A1A2E; line-height: 1.25;">{{profile.name}}</view>
      <view class="type-line" style="color: {{typeInfo.color}};">
        <text style="font-size: 36rpx; margin-right: 10rpx;">{{typeInfo.emoji}}</text>
        <text>{{profile.typeLabel || typeInfo.label}}</text>
      </view>
      <view style="font-size: 24rpx; color: #8395A7; margin-top: 8rpx;">{{typeInfo.desc}}</view>
      <view wx:if="{{profile.note}}" class="note-block">{{profile.note}}</view>
    </view>

    <view class="quick-grid">
      <button bindtap="goDiagnose">
        <text>🩺</text>
        <view>确诊</view>
      </button>
      <button bindtap="goCheck">
        <text>💊</text>
        <view>发不发</view>
      </button>
      <button bindtap="goPredict">
        <text>🔭</text>
        <view>预测</view>
      </button>
    </view>

    <view wx:if="{{latest}}" class="card latest-card" data-id="{{latest.id}}" bindtap="openHistory">
      <view class="section-title">最近一次分析</view>
      <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14rpx;">
        <view class="pill warm">{{latest.kindLabel}}</view>
        <view style="font-size: 22rpx; color: #C8D6E5;">{{latest.timeText}}</view>
      </view>
      <view class="serif" style="font-size: 34rpx; font-weight: 900; color: #1A1A2E; line-height: 1.4;">{{latest.title}}</view>
      <view style="font-size: 26rpx; color: rgba(26,26,46,0.72); line-height: 1.8; margin-top: 12rpx;">{{latest.summary}}</view>
      <view style="margin-top: 18rpx; color: #B8860B; font-size: 24rpx; font-weight: 800;">查看完整结果 ›</view>
    </view>

    <view class="section-head">
      <view>
        <view class="serif" style="font-size: 36rpx; font-weight: 900; color: #1A1A2E;">专属历史</view>
        <view style="font-size: 23rpx; color: #8395A7; margin-top: 4rpx;">{{records.length}} 条记录，只看这个 Ta</view>
      </view>
    </view>

    <view wx:if="{{!records.length}}" class="empty-card">
      <view style="font-size: 58rpx; margin-bottom: 14rpx;">🗂️</view>
      <view class="serif" style="font-size: 30rpx; font-weight: 900; color: #1A1A2E;">还没有这个人的分析</view>
      <view style="font-size: 25rpx; color: #8395A7; margin-top: 8rpx;">先做一次确诊，后面就不用从一堆记录里翻了</view>
    </view>

    <view wx:for="{{records}}" wx:key="id" class="timeline-card" data-id="{{item.id}}" bindtap="openHistory">
      <view class="dot"></view>
      <view style="flex: 1;">
        <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10rpx;">
          <view class="pill warm">{{item.kindLabel}}</view>
          <view style="font-size: 22rpx; color: #C8D6E5;">{{item.timeText}}</view>
        </view>
        <view class="serif" style="font-size: 30rpx; font-weight: 900; color: #1A1A2E; line-height: 1.4;">{{item.title}}</view>
        <view style="font-size: 25rpx; color: rgba(26,26,46,0.72); line-height: 1.7; margin-top: 10rpx;">{{item.summary}}</view>
        <view wx:if="{{item.imageCount}}" style="margin-top: 12rpx; color: #00B894; font-size: 23rpx; font-weight: 800;">含 {{item.imageCount}} 张截图</view>
      </view>
    </view>
  </view>
</view>
