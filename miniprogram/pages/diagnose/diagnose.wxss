.type-mini {
  border-radius: 40rpx;
  padding: 40rpx 28rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #1A1A2E;
  position: relative;
  overflow: hidden;
}

.loading-dots {
  display: flex;
  gap: 8rpx;
}

.loading-dots view {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #2D3436, #636E72);
  animation: bounce 0.9s ease infinite;
}

.loading-dots view:nth-child(2) { animation-delay: 0.15s; }
.loading-dots view:nth-child(3) { animation-delay: 0.3s; }

@keyframes bounce {
  0%, 100% { transform: translateY(0); opacity: 0.4; }
  50% { transform: translateY(-6px); opacity: 1; }
}

.skeleton {
  border-radius: 40rpx;
  background: linear-gradient(90deg, rgba(0,0,0,0.04), #F8FAFB, rgba(0,0,0,0.04));
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.shot-panel {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #F8FAFB;
}

.shot-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.shot-tile {
  position: relative;
  height: 128rpx;
  border-radius: 22rpx;
  overflow: hidden;
  background: #EDF4FA;
}

.shot-img {
  width: 100%;
  height: 100%;
  display: block;
}

.shot-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  background: rgba(26,26,46,0.72);
  color: #fff;
  font-size: 26rpx;
  line-height: 34rpx;
  text-align: center;
  font-weight: 800;
}

.shot-order {
  position: absolute;
  left: 8rpx;
  bottom: 8rpx;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.86);
  color: #2D3436;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
  font-weight: 800;
}
