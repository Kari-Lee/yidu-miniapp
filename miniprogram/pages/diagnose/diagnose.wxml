<view class="container" style="padding-bottom: 120rpx;">
  <view style="height: {{statusBarHeight}}px"></view>
  <view style="padding: 24rpx 0;">
    <text bindtap="goBack" style="font-size: 24rpx; color: #B8860B; font-weight: 600;">‹ 返回</text>
  </view>

  <!-- ═══ INPUT ═══ -->
  <view wx:if="{{step === 'input'}}" class="fu">
    <view wx:if="{{err}}" style="padding: 28rpx 36rpx; background: #FFF5F5; border-radius: 28rpx; margin-bottom: 28rpx; font-size: 26rpx; color: #E17055; border: 2rpx solid #FFE3E3;">{{err}}</view>
    <view class="notice">
      <view class="notice-title">上传前先打码</view>
      <view>聊天截图会用于本次 AI 分析。建议隐藏头像、昵称、手机号和地址；结果只供关系观察参考，不是心理诊断。</view>
    </view>
    <view class="card" style="padding: 52rpx;">
      <!-- 图片上传 -->
      <view style="margin-bottom: 32rpx;">
        <view bindtap="chooseImg" style="display: flex; align-items: center; justify-content: center; gap: 16rpx; padding: 32rpx; border-radius: 32rpx; border: 4rpx dashed {{imgs.length ? 'rgba(0,184,148,0.5)' : 'rgba(0,0,0,0.04)'}}; background: {{imgs.length ? '#F0FFF4' : '#F4F8FB'}}; color: {{imgs.length ? '#00B894' : '#C8D6E5'}}; font-size: 28rpx; font-weight: 600;">
          <text style="font-size: 44rpx;">{{imgs.length ? '📎' : '📷'}}</text>
          <text>{{imgs.length ? imgs.length + '张截图已选择 · 最多4张' : '上传聊天截图（最多4张）'}}</text>
        </view>
        <view style="text-align: center; font-size: 24rpx; color: #C8D6E5; margin: 24rpx 0 12rpx;">—— 或 ——</view>
      </view>
      <textarea style="width: 100%; padding: 28rpx 8rpx; background: transparent; border: none; color: #1A1A2E; font-size: 30rpx; line-height: 1.9;" maxlength="-1" auto-height placeholder="粘贴聊天记录..." placeholder-style="color: #C8D6E5" value="{{text}}" bindinput="onInput"></textarea>
    </view>
    <button class="btn-main" style="margin-top: 32rpx; background: {{hasInput ? '#2D3436' : '#ddd'}};" disabled="{{!hasInput}}" bindtap="nextStep">开始确诊 🩺</button>
  </view>

  <!-- ═══ CONTEXT ═══ -->
  <view wx:if="{{step === 'context'}}" class="fu">
    <view class="card" style="padding: 56rpx;">
      <view class="serif" style="font-size: 44rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 16rpx;">Ta是你的什么人？</view>
      <view style="font-size: 26rpx; color: #8395A7; margin-bottom: 40rpx;">比如：暧昧三个月 / 同事 / Ta总是已读不回</view>
      <textarea style="width: 100%; padding: 28rpx 8rpx; background: transparent; border: none; border-top: 2rpx solid rgba(0,0,0,0.04); color: #1A1A2E; font-size: 30rpx; line-height: 1.9;" auto-height placeholder="正在折磨我的人..." placeholder-style="color: #C8D6E5" value="{{ctx}}" bindinput="onCtxInput"></textarea>
    </view>
    <view style="display: flex; gap: 20rpx; margin-top: 28rpx;">
      <button class="btn-reset" style="flex: 1;" bindtap="backToInput">返回</button>
      <button class="btn-main" style="flex: 2;" bindtap="submit">确诊 🩺</button>
    </view>
  </view>

  <!-- ═══ LOADING ═══ -->
  <view wx:if="{{step === 'loading'}}" class="fu" style="text-align: center;">
    <view style="display: inline-flex; align-items: center; gap: 20rpx; padding: 28rpx 56rpx; border-radius: 999rpx; background: #fff; box-shadow: 0 8rpx 48rpx rgba(0,0,0,0.06); margin-bottom: 40rpx;">
      <view class="loading-dots"><view></view><view></view><view></view></view>
      <text style="font-size: 26rpx; color: #8395A7;">{{loadingMsg}}</text>
    </view>
    <view style="opacity: 0.5;">
      <view style="display: flex; gap: 24rpx; margin-bottom: 28rpx;">
        <view class="skeleton" style="flex: 1; height: 280rpx;"></view>
        <view class="skeleton" style="flex: 1; height: 280rpx;"></view>
      </view>
      <view class="skeleton" style="height: 160rpx; margin-bottom: 28rpx;"></view>
      <view class="skeleton" style="height: 240rpx;"></view>
    </view>
  </view>

  <!-- ═══ RESULT ═══ -->
  <view wx:if="{{step === 'result' && res}}" class="fu">
    <!-- 双方类型卡片 -->
    <view style="display: flex; gap: 24rpx; margin-bottom: 28rpx;">
      <view class="type-mini" style="background: {{userGrad}}; flex: 1;">
        <text style="font-size: 80rpx; margin-bottom: 16rpx;">{{userTI.emoji}}</text>
        <text class="serif" style="font-size: 44rpx; font-weight: 900;">你：{{res.user_label}}</text>
        <text style="font-size: 24rpx; opacity: 0.8;">{{userTI.desc}}</text>
      </view>
      <view class="type-mini" style="background: {{partnerGrad}}; flex: 1;">
        <text style="font-size: 80rpx; margin-bottom: 16rpx;">{{partnerTI.emoji}}</text>
        <text class="serif" style="font-size: 44rpx; font-weight: 900;">Ta：{{res.partner_label}}</text>
        <text style="font-size: 24rpx; opacity: 0.8;">{{partnerTI.desc}}</text>
      </view>
    </view>

    <!-- 互动模式 -->
    <view class="card" style="background: linear-gradient(135deg, #F8FAFB, #F0E6F6); border: none;">
      <view class="serif" style="font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx;">🔗 互动模式</view>
      <view style="font-size: 30rpx; line-height: 1.9; color: rgba(26,26,46,0.87);">{{res.match}}</view>
    </view>

    <!-- 置信度 -->
    <view class="card">
      <view style="display: flex; justify-content: space-between;">
        <text style="font-size: 26rpx; color: #8395A7; font-weight: 700;">置信度</text>
        <text style="font-size: 48rpx; font-weight: 900; color: #2D3436;">{{res.confidence}}%</text>
      </view>
      <view style="height: 10rpx; background: rgba(0,0,0,0.04); border-radius: 99rpx; overflow: hidden; margin-top: 20rpx;">
        <view style="height: 100%; width: {{res.confidence}}%; background: linear-gradient(90deg, #2D3436, #636E72); border-radius: 99rpx;"></view>
      </view>
    </view>

    <!-- 暴露信号 -->
    <view class="card" style="padding: 48rpx;">
      <view style="font-size: 26rpx; color: #8395A7; font-weight: 700; margin-bottom: 28rpx;">暴露信号</view>
      <view wx:for="{{res.signals}}" wx:key="index" style="display: flex; gap: 24rpx; padding: 24rpx 0; {{index < 2 ? 'border-bottom: 2rpx solid rgba(0,0,0,0.04);' : ''}}">
        <view style="width: 72rpx; height: 72rpx; border-radius: 24rpx; background: {{item.who === '用户' ? '#FFF5F3' : '#F0F6FA'}}; display: flex; align-items: center; justify-content: center; font-size: 32rpx; flex-shrink: 0;">{{item.icon}}</view>
        <view style="flex: 1;">
          <view style="font-size: 24rpx; color: #8395A7; margin-bottom: 4rpx;">{{item.who}}</view>
          <view class="serif" style="font-size: 28rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 8rpx;">「{{item.msg}}」</view>
          <view style="font-size: 26rpx; color: #8395A7;">→ {{item.meaning}}</view>
        </view>
      </view>
    </view>

    <!-- 建议 -->
    <view class="card" style="background: {{userBg}}; border: none;">
      <view class="serif" style="font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx;">💡 给你</view>
      <view style="font-size: 28rpx; line-height: 1.9; color: rgba(26,26,46,0.87);">{{res.user_advice}}</view>
    </view>
    <view class="card" style="background: {{partnerBg}}; border: none;">
      <view class="serif" style="font-size: 28rpx; font-weight: 700; margin-bottom: 16rpx;">🎯 应对Ta</view>
      <view style="font-size: 28rpx; line-height: 1.9; color: rgba(26,26,46,0.87);">{{res.partner_advice}}</view>
    </view>

    <button class="btn-reset" style="margin-top: 16rpx;" bindtap="resetInput">再来一次 ↻</button>
    <view class="disclaimer">以上分析由 AI 根据你提供的内容生成，只适合做自我觉察和沟通参考。别拿它当判决书，更别替代专业心理咨询。</view>
  </view>
</view>
