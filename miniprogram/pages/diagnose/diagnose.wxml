<view class="tool-page">
  <view style="height: {{statusBarHeight}}px"></view>
  <view class="tool-topbar">
    <text class="tool-back" bindtap="goBack">← 返回</text>
    <text class="tool-brand">YIDU</text>
  </view>

  <view wx:if="{{step === 'input'}}" class="fu">
    <view class="tool-head">
      <view class="tool-head-no">02</view>
      <view class="tool-kicker">CHAT DIAGNOSIS</view>
      <view class="tool-title"><view>上传聊天</view><view>看清你们怎么拉扯</view></view>
      <view class="tool-intro">支持多张截图。系统会自动优化并快速分析，不需要你手动裁剪文件大小。</view>
    </view>
    <view wx:if="{{err}}" class="tool-error">{{err}}</view>
    <view wx:if="{{contextTip}}" class="context-tip">
      <view class="context-tip-head">
        <view style="flex: 1;">
          <view class="context-tip-title">带入关系历史</view>
          <view class="context-tip-sub">{{ctxEnabled ? '档案与最近记录会参与分析' : '本次只分析新内容'}}</view>
        </view>
        <switch checked="{{ctxEnabled}}" color="#2D2F33" bindchange="toggleCtxEnabled" style="transform: scale(0.78);"></switch>
      </view>
      <view class="context-actions">
        <text class="context-link" bindtap="toggleCtxPreview">{{ctxPreviewOpen ? '收起内容' : '查看内容'}}</text>
        <text class="context-muted">{{profileHistoryCount}} 条历史摘要</text>
      </view>
      <view wx:if="{{ctxPreviewOpen}}" class="context-preview">{{ctx}}</view>
    </view>

    <view class="upload-zone {{imgs.length ? 'has-files' : ''}}" bindtap="chooseImg">
      <view class="upload-no">{{imgs.length ? imgs.length : '+'}}</view>
      <view>
        <view class="upload-title">{{imgs.length ? '截图已自动优化' : '选择聊天截图'}}</view>
        <view class="upload-sub">{{imgs.length ? '继续添加或点击下方预览' : '可一次多选，上传前请隐藏隐私'}}</view>
      </view>
      <view class="upload-arrow">↗</view>
    </view>

    <view wx:if="{{imgs.length}}" class="shot-panel">
      <view class="shot-head"><text>SCREENSHOTS / {{imgs.length}}</text><text bindtap="clearImgs">清空</text></view>
      <view class="shot-grid">
        <view wx:for="{{imgs}}" wx:key="path" class="shot-tile" data-index="{{index}}" bindtap="previewImg">
          <image class="shot-img" src="{{item.path}}" mode="aspectFill"></image>
          <view class="shot-remove" data-index="{{index}}" catchtap="removeImg">×</view>
          <view class="shot-order">0{{index + 1}}</view>
        </view>
      </view>
    </view>

    <view class="or-line"><text>或粘贴聊天文字</text></view>
    <view class="tool-surface">
      <textarea class="tool-textarea" maxlength="-1" auto-height placeholder="粘贴聊天记录…" placeholder-style="color: #B7BBC4" value="{{text}}" bindinput="onInput"></textarea>
    </view>
    <button class="tool-primary" disabled="{{!hasInput}}" bindtap="nextStep"><text>继续补充背景</text><text>↗</text></button>
  </view>

  <view wx:if="{{step === 'context'}}" class="fu">
    <view class="tool-head compact">
      <view class="tool-kicker">RELATION CONTEXT</view>
      <view class="tool-title"><view>Ta 是你的</view><view>什么人</view></view>
      <view class="tool-intro">补充关系、时长和最常出现的拉扯模式。</view>
    </view>
    <view class="tool-surface">
      <textarea class="tool-textarea context-area" auto-height placeholder="例如：暧昧三个月，Ta 每次靠近后又消失…" placeholder-style="color: #B7BBC4" value="{{ctx}}" bindinput="onCtxInput"></textarea>
      <view wx:if="{{contextTip}}" class="context-inline">
        <text>{{ctxEnabled ? '历史档案已开启' : '历史档案已关闭'}}</text>
        <switch checked="{{ctxEnabled}}" color="#2D2F33" bindchange="toggleCtxEnabled" style="transform: scale(0.72);"></switch>
      </view>
    </view>
    <view class="tool-button-row">
      <button class="tool-secondary" bindtap="backToInput">返回修改</button>
      <button class="tool-primary no-margin" disabled="{{submitting}}" bindtap="submit"><text>开始分析</text><text>↗</text></button>
    </view>
  </view>

  <view wx:if="{{step === 'loading'}}" class="fu loading-stage">
    <view class="loading-index">02</view>
    <view class="loading-title">{{loadingMsg}}</view>
    <view class="loading-sub">正在识别谁在追、谁在躲，以及谁嘴上没事心里已经演完三季。</view>
    <view class="loading-bar"><view></view></view>
  </view>

  <view wx:if="{{step === 'result' && res}}" class="fu">
    <view class="result-lead">
      <view class="result-kicker">DUAL ATTACHMENT REPORT</view>
      <view class="result-title"><view>你们不是没感情</view><view>是模式在互相点火</view></view>
    </view>

    <view class="type-duo">
      <view class="type-panel">
        <view class="type-role">YOU / 你</view>
        <view class="type-name" style="color: {{userTI.color}};">{{res.user_label}}</view>
        <view class="type-desc">{{userTI.desc}}</view>
      </view>
      <view class="type-panel dark">
        <view class="type-role">THEM / Ta</view>
        <view class="type-name" style="color: {{partnerTI.color}};">{{res.partner_label}}</view>
        <view class="type-desc">{{partnerTI.desc}}</view>
      </view>
    </view>

    <view class="result-section">
      <view class="result-section-label">INTERACTION LOOP</view>
      <view class="result-section-title">你们的互动循环</view>
      <view class="result-copy">{{res.match}}</view>
      <view class="confidence-line">
        <text>分析置信度</text><text>{{res.confidence}}%</text>
      </view>
      <view class="confidence-track"><view style="width: {{res.confidence}}%;"></view></view>
    </view>

    <view class="result-section">
      <view class="result-section-label">EXPOSED SIGNALS</view>
      <view class="result-section-title">聊天里已经暴露的信号</view>
      <view wx:for="{{res.signals}}" wx:key="index" class="signal-row">
        <view class="signal-no">0{{index + 1}}</view>
        <view class="signal-body">
          <view class="signal-who">{{item.who}}</view>
          <view class="signal-msg">「{{item.msg}}」</view>
          <view class="signal-meaning">{{item.meaning}}</view>
        </view>
      </view>
    </view>

    <view class="advice-grid">
      <view><text>给你</text><view>{{res.user_advice}}</view></view>
      <view><text>应对 Ta</text><view>{{res.partner_advice}}</view></view>
    </view>

    <view wx:if="{{profileId}}" class="profile-sync">
      <view style="flex: 1;">
        <view class="profile-sync-title">写回关系档案</view>
        <view class="profile-sync-desc">{{profileName || '这段关系'}}：Ta 标记为 {{res.partner_label}}</view>
      </view>
      <button class="profile-sync-btn {{profileSynced ? 'done' : ''}}" disabled="{{profileSynced}}" bindtap="syncPartnerType">{{profileSynced ? '已更新' : '写入'}}</button>
    </view>

    <button class="tool-primary" bindtap="goReply"><text>帮我写下一句</text><text>↗</text></button>
    <view class="result-action-grid">
      <button class="result-action" bindtap="resetInput">重新分析</button>
      <button class="result-action" bindtap="copyResult">复制结果</button>
      <button class="result-action dark" open-type="share">分享给朋友 ↗</button>
    </view>
    <view class="disclaimer">分析只适合做自我觉察和沟通参考。别拿它当判决书，更别替代专业心理咨询。</view>
  </view>
</view>
