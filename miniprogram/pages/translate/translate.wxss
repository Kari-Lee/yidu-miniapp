.loading-dots {
  display: flex; gap: 8rpx;
}
.loading-dots view {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: linear-gradient(135deg, #636E72, #8395A7);
  animation: bounce 0.9s ease infinite;
}
.loading-dots view:nth-child(2) { animation-delay: 0.15s; }
.loading-dots view:nth-child(3) { animation-delay: 0.3s; }
@keyframes bounce {
  0%, 100% { transform: translateY(0); opacity: 0.4; }
  50% { transform: translateY(-6px); opacity: 1; }
}
.skeleton {
  border-radius: 40rpx;
  background: linear-gradient(90deg, rgba(0,0,0,0.04), #F8FAFB, rgba(0,0,0,0.04));
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}
