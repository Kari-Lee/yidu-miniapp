<view class="tool-page">
  <view style="height: {{statusBarHeight}}px"></view>
  <view class="tool-topbar">
    <text class="tool-back" bindtap="goBack">← 返回</text>
    <text class="tool-brand">YIDU</text>
  </view>

  <view wx:if="{{step === 'input'}}" class="fu">
    <view class="tool-head">
      <view class="tool-head-no">01</view>
      <view class="tool-kicker">SUBTEXT TRANSLATOR</view>
      <view class="tool-title"><view>Ta 说的话</view><view>翻译成人话</view></view>
      <view class="tool-intro">一句话不够判断真心，但足够看出回避、敷衍和试探。少贴隐私，多贴上下文。</view>
    </view>

    <view wx:if="{{err}}" class="tool-error">{{err}}</view>
    <view wx:if="{{contextTip}}" class="context-tip">
      <view class="context-tip-head">
        <view style="flex: 1;">
          <view class="context-tip-title">带入关系历史</view>
          <view class="context-tip-sub">{{ctxEnabled ? '本次会参考档案和最近记录' : '本次只翻译这句话'}}</view>
        </view>
        <switch checked="{{ctxEnabled}}" color="#2D2F33" bindchange="toggleCtxEnabled" style="transform: scale(0.78);"></switch>
      </view>
      <view class="context-actions">
        <text class="context-link" bindtap="toggleCtxPreview">{{ctxPreviewOpen ? '收起内容' : '查看内容'}}</text>
        <text class="context-muted">{{profileHistoryCount}} 条历史摘要</text>
      </view>
      <view wx:if="{{ctxPreviewOpen}}" class="context-preview">{{ctx}}</view>
    </view>
    <view class="tool-surface">
      <view class="surface-label">PASTE THE MESSAGE</view>
      <textarea class="tool-textarea" maxlength="-1" auto-height placeholder="把 Ta 的原话贴在这里，可一行一句…" placeholder-style="color: #B7BBC4" value="{{text}}" bindinput="onInput"></textarea>
      <view class="surface-note">AI 不是读心术，后续行动比一句话更诚实。</view>
    </view>
    <button class="tool-primary" disabled="{{!hasInput || submitting}}" bindtap="submit">
      <text>开始翻译</text><text class="tool-primary-arrow">↗</text>
    </button>
  </view>

  <view wx:if="{{step === 'loading'}}" class="fu loading-stage">
    <view class="loading-index">01</view>
    <view class="loading-title">{{loadingMsg}}</view>
    <view class="loading-sub">正在拆掉语气、措辞和上下文的伪装。</view>
    <view class="loading-bar"><view></view></view>
  </view>

  <view wx:if="{{step === 'result' && res}}" class="fu">
    <view class="result-lead">
      <view class="result-kicker">TRANSLATION REPORT</view>
      <view class="result-title"><view>人话版本</view><view>已经翻译完了</view></view>
    </view>

    <view wx:for="{{res.translations}}" wx:key="index" class="translation-block">
      <view class="original-line">
        <text>TA SAID</text>
        <view>「{{item.original}}」</view>
      </view>
      <view class="translation-verdict">{{item.verdict}}</view>
      <view class="possibility-list">
        <view wx:for="{{item.possibilities}}" wx:for-item="p" wx:for-index="pi" wx:key="pi" class="possibility-row {{pi === 0 ? 'primary' : ''}}">
          <view class="possibility-rank">{{p.label}}</view>
          <view class="possibility-body">
            <view class="possibility-head"><text>{{p.meaning}}</text><text>{{p.percent}}%</text></view>
            <view class="possibility-reason">{{p.reason}}</view>
          </view>
        </view>
      </view>
      <view class="likely-line"><text>最可能是 {{item.most_likely}}</text><view>{{item.why}}</view></view>
    </view>

    <view class="result-action-grid has-poster">
      <button class="result-action" bindtap="resetInput">重新翻译</button>
      <button class="result-action" bindtap="copyResult">复制结果</button>
      <button class="result-action" disabled="{{posterSaving}}" bindtap="saveResultPoster">{{posterSaving ? '生成中' : '保存结果图'}}</button>
      <button class="result-action dark" open-type="share">分享给朋友 ↗</button>
    </view>
    <view wx:if="{{currentRecordId}}" class="daily-feedback">
      <view class="feedback-title">这次你准备怎么做？</view>
      <view class="feedback-row">
        <view class="{{feedbackAction === 'sent' ? 'active' : ''}}" data-value="sent" bindtap="markAction">已发</view>
        <view class="{{feedbackAction === 'skipped' ? 'active' : ''}}" data-value="skipped" bindtap="markAction">不发了</view>
        <view class="{{feedbackAction === 'thinking' ? 'active' : ''}}" data-value="thinking" bindtap="markAction">再想想</view>
      </view>
      <view class="feedback-title sub">Ta 后来回了吗？</view>
      <view class="feedback-row">
        <view class="{{feedbackResponse === 'replied' ? 'active' : ''}}" data-value="replied" bindtap="markResponse">回了</view>
        <view class="{{feedbackResponse === 'silent' ? 'active' : ''}}" data-value="silent" bindtap="markResponse">没回</view>
        <view class="{{feedbackResponse === 'cold' ? 'active' : ''}}" data-value="cold" bindtap="markResponse">很敷衍</view>
      </view>
    </view>
    <view class="disclaimer">潜台词不是读心术。真正有用的是看 Ta 后续怎么做，而不是把一句话审到天亮。</view>
  </view>
  <canvas type="2d" id="resultPoster" class="result-poster-canvas"></canvas>
</view>
