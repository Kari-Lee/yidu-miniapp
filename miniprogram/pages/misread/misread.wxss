.misread-page {
  min-height: 100vh;
  padding: 0 40rpx calc(150rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #F2F3F5;
  color: #17191C;
  overflow-x: hidden;
}

.misread-page.is-loading {
  padding: 0;
  background: #17191C;
}

.misread-screen {
  position: relative;
  z-index: 1;
  animation: misread-rise 0.26s ease both;
}

.ghost-brand {
  position: absolute;
  top: 4rpx;
  left: -8rpx;
  z-index: -1;
  color: #E9EBEE;
  font-size: 96rpx;
  font-weight: 900;
  letter-spacing: 12rpx;
  line-height: 1;
}

.misread-topbar {
  min-height: 84rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #17191C;
  font-size: 24rpx;
  font-weight: 900;
}

.misread-topbar text:last-child {
  font-size: 20rpx;
  letter-spacing: 5rpx;
}

.input-screen .misread-topbar {
  justify-content: flex-end;
}

.input-screen .misread-topbar text:first-child {
  display: none;
}

.misread-kicker,
.safety-kicker {
  margin-top: 28rpx;
  color: #B6BAC0;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 5rpx;
}

.misread-title {
  margin-top: 18rpx;
  color: #17191C;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1.24;
}

.misread-intro {
  margin-top: 16rpx;
  color: #6B7077;
  font-size: 25rpx;
}

.profile-pill {
  display: inline-flex;
  margin-top: 22rpx;
  padding: 9rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(45,158,224,0.1);
  color: #1887C7;
  font-size: 20rpx;
  font-weight: 800;
}

.misread-error {
  margin-top: 20rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: rgba(225,112,85,0.1);
  color: #C6533D;
  font-size: 22rpx;
}

.input-card {
  min-height: 390rpx;
  margin-top: 32rpx;
  padding: 28rpx 30rpx 20rpx;
  border-radius: 34rpx;
  background: #FFFFFF;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  box-shadow: 0 20rpx 44rpx rgba(45,47,51,0.05);
}

.message-input {
  width: 100%;
  min-height: 240rpx;
  flex: 1;
  color: #17191C;
  font-size: 26rpx;
  line-height: 1.65;
  box-sizing: border-box;
}

.image-strip {
  display: flex;
  gap: 12rpx;
  margin: 14rpx 0;
  overflow-x: auto;
}

.image-tile {
  position: relative;
  width: 94rpx;
  height: 94rpx;
  flex: 0 0 94rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #EFF0F2;
}

.image-tile image {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 5rpx;
  right: 5rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: rgba(23,25,28,0.82);
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 28rpx;
  text-align: center;
}

.input-card-footer {
  min-height: 58rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #EFF0F2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.upload-link,
.try-link {
  color: #9AA0A6;
  font-size: 22rpx;
}

.try-link {
  color: #2D9EE0;
  text-align: right;
}

.mode-switch {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 8rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
}

.mode-switch view {
  min-height: 74rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6B7077;
  font-size: 25rpx;
  font-weight: 700;
}

.mode-switch view.active {
  background: #1C1E21;
  color: #FFFFFF;
}

.mode-hint {
  margin: 12rpx 0 24rpx 12rpx;
  color: #9AA0A6;
  font-size: 21rpx;
}

.start-button,
.serious-button {
  width: 100%;
  min-height: 100rpx;
  border: none;
  border-radius: 999rpx;
  background: #17191C;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.start-button::after,
.serious-button::after,
.candidate-footer button::after,
.refresh-button::after,
.switch-button::after,
.safety-reset::after {
  border: none;
}

.start-button text:last-child,
.serious-button text:last-child {
  color: #2D9EE0;
}

.start-button[disabled] {
  background: #D9DBDE;
  color: #9AA0A6;
}

.safety-note,
.submission-note {
  margin-top: 14rpx;
  color: #9AA0A6;
  font-size: 21rpx;
  text-align: center;
}

.loading-screen {
  min-height: 100vh;
  padding: 0 54rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #17191C;
}

.loading-brand {
  position: absolute;
  top: 78rpx;
  color: rgba(255,255,255,0.24);
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
}

.loading-copy {
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 900;
  text-align: center;
}

.loading-track {
  width: 220rpx;
  height: 4rpx;
  margin-top: 44rpx;
  background: rgba(255,255,255,0.14);
  overflow: hidden;
}

.loading-track view {
  width: 42%;
  height: 100%;
  background: #2D9EE0;
  animation: loading-move 1.1s ease-in-out infinite alternate;
}

.result-screen,
.safety-screen {
  padding-bottom: 20rpx;
}

.source-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  margin: 24rpx 0 28rpx;
}

.source-row > text {
  flex-shrink: 0;
  margin-top: 12rpx;
  color: #B6BAC0;
  font-size: 20rpx;
}

.source-row > view {
  max-width: 86%;
  padding: 15rpx 22rpx;
  border-radius: 24rpx 24rpx 24rpx 7rpx;
  background: #E4E6E9;
  color: #4A4E54;
  font-size: 23rpx;
  line-height: 1.5;
}

.result-title,
.safety-title {
  color: #17191C;
  font-size: 40rpx;
  font-weight: 900;
}

.result-subtitle {
  margin-top: 5rpx;
  color: #9AA0A6;
  font-size: 22rpx;
}

.candidate-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.candidate-card {
  padding: 26rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  box-shadow: 0 14rpx 32rpx rgba(45,47,51,0.04);
}

.candidate-type {
  color: #2D9EE0;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
}

.candidate-text {
  margin-top: 12rpx;
  color: #17191C;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.58;
  white-space: pre-wrap;
}

.candidate-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 20rpx;
}

.candidate-footer > text {
  flex: 1;
  color: #B6BAC0;
  font-size: 19rpx;
  line-height: 1.45;
}

.candidate-footer button {
  min-width: 120rpx;
  height: 60rpx;
  padding: 0 24rpx;
  border: none;
  border-radius: 999rpx;
  background: #F2F3F5;
  color: #17191C;
  font-size: 21rpx;
  font-weight: 900;
  line-height: 60rpx;
}

.candidate-footer button.copied {
  background: #1C1E21;
  color: #FFFFFF;
}

.result-actions {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 14rpx;
  margin-top: 24rpx;
}

.refresh-button,
.switch-button,
.safety-reset {
  min-height: 88rpx;
  border: none;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.refresh-button {
  background: #17191C;
  color: #FFFFFF;
}

.refresh-button text {
  color: #2D9EE0;
}

.switch-button,
.safety-reset {
  padding: 0 34rpx;
  background: #FFFFFF;
  color: #6B7077;
}

.safety-kicker {
  margin-top: 70rpx;
  color: #2D9EE0;
}

.safety-title {
  margin-top: 14rpx;
  font-size: 54rpx;
}

.safety-card {
  margin-top: 32rpx;
  padding: 38rpx 34rpx;
  border-radius: 32rpx;
  background: #1C1E21;
  color: #FFFFFF;
}

.safety-card view {
  font-size: 30rpx;
  font-weight: 900;
  line-height: 1.6;
}

.safety-card text {
  display: block;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.62);
  font-size: 23rpx;
  line-height: 1.7;
}

.serious-button {
  margin-top: 28rpx;
}

.safety-reset {
  width: 100%;
  margin-top: 14rpx;
}

.misread-tabs {
  position: fixed;
  left: 34rpx;
  right: 34rpx;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  z-index: 20;
  height: 96rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.94);
  box-shadow: 0 18rpx 44rpx rgba(45,47,51,0.13);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: center;
}

.misread-tabs view {
  color: #B6BAC0;
  font-size: 22rpx;
  font-weight: 800;
  text-align: center;
}

.misread-tabs view.active {
  color: #17191C;
}

@keyframes misread-rise {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes loading-move {
  from { transform: translateX(-40rpx); }
  to { transform: translateX(160rpx); }
}
