<view class="home-page">
  <view style="height: {{statusBarHeight + 10}}px"></view>

  <view class="poster-word">YIDU</view>
  <view class="topbar">
    <view class="brand">YIDU</view>
    <view class="top-dot"></view>
  </view>

  <view wx:if="{{activeTab === 'test'}}" class="panel test-panel">
    <view class="kicker">ATTACHMENT TEST</view>
    <view class="headline">
      <view>测出你的</view>
      <view>依恋人格</view>
    </view>
    <view class="subline">24 道题，看清你在关系里的真实反应。</view>

    <view
      class="hero-action"
      bindtap="goQuiz"
      hover-class="hero-action-pressed"
      hover-start-time="20"
      hover-stay-time="120"
    >
      <view>
        <view class="action-title">开始测试</view>
        <view class="action-desc">生成你的四维关系画像</view>
      </view>
      <view class="action-arrow">↗</view>
    </view>

    <view
      class="quiet-link"
      bindtap="goProfiles"
      hover-class="quiet-link-pressed"
      hover-start-time="20"
      hover-stay-time="100"
    >已有 Ta？去建关系档案</view>

    <view
      class="misread-feature"
      bindtap="goMisread"
      hover-class="misread-feature-pressed"
      hover-start-time="20"
      hover-stay-time="120"
    >
      <view class="misread-kicker">MISREAD REPLY · NEW</view>
      <view class="misread-head">
        <view>
          <view class="misread-title">已读，乱回。</view>
          <view class="misread-desc">不知道怎么回的时候，帮你幽默地回</view>
        </view>
        <view class="misread-arrow">↗</view>
      </view>
      <view class="misread-demo">
        <view class="demo-in"><text>{{misreadSample.input}}</text></view>
        <view class="demo-out"><text>{{misreadSample.output}}</text></view>
      </view>
    </view>

    <view class="quote-line compact">
      <view class="quote-mark">“</view>
      <view>已读不回是冷暴力，已读乱回是行为艺术</view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'relation'}}" class="panel relation-panel">
    <view class="kicker">RELATION FILE</view>
    <view class="headline small">
      <view>把每个 Ta</view>
      <view>分开观察</view>
    </view>
    <view class="subline">翻译、发不发、下一句和关系预测都收进档案里。先选 Ta，再分析，别把不同的人混成一锅。</view>

    <view
      class="hero-action dark"
      bindtap="goProfiles"
      hover-class="hero-action-pressed"
      hover-start-time="20"
      hover-stay-time="120"
    >
      <view>
        <view class="action-title">进入关系档案</view>
        <view class="action-desc">长期观察同一个人</view>
      </view>
      <view class="action-arrow">↗</view>
    </view>

    <view wx:if="{{followupCard}}" class="followup-card">
      <view class="followup-head">
        <text>FOLLOW UP</text>
        <view>{{followupCard.timeText}}</view>
      </view>
      <view class="followup-title">Ta 后来回了吗？</view>
      <view class="followup-copy">{{followupCard.profileName}}｜{{followupCard.copy}}</view>
      <view class="followup-actions">
        <view data-value="replied" bindtap="markFollowupResponse">回了</view>
        <view data-value="silent" bindtap="markFollowupResponse">没回</view>
        <view data-value="cold" bindtap="markFollowupResponse">很敷衍</view>
      </view>
      <view class="followup-link" bindtap="openFollowupRecord">
        <text>查看上次记录</text>
        <text>↗</text>
      </view>
    </view>

    <view
      wx:if="{{weeklyCard}}"
      class="weekly-home-card {{weeklyCard.ready ? 'ready' : ''}}"
      bindtap="goWeeklyCard"
      hover-class="weekly-home-card-pressed"
      hover-start-time="20"
      hover-stay-time="120"
    >
      <view class="weekly-home-head">
        <text>{{weeklyCard.badge}}</text>
        <view>{{weeklyCard.countText}}</view>
      </view>
      <view class="weekly-home-title">{{weeklyCard.title}}</view>
      <view class="weekly-home-copy">{{weeklyCard.copy}}</view>
      <view class="weekly-home-progress">
        <view style="width: {{weeklyCard.progress}}%;"></view>
      </view>
      <view class="weekly-home-action">
        <text>{{weeklyCard.action}}</text>
        <text>↗</text>
      </view>
    </view>

    <view class="step-list">
      <view class="step-row">
        <text>01</text>
        <view>建 Ta 的档案</view>
      </view>
      <view class="step-row">
        <text>02</text>
        <view>丢一句话或聊天截图</view>
      </view>
      <view class="step-row last">
        <text>03</text>
        <view>结果自动归到这个 Ta 名下</view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'record'}}" class="panel record-panel">
    <view class="kicker">RECORDS</view>
    <view class="headline small">
      <view>你的关系</view>
      <view>观察记录</view>
    </view>
    <view class="subline">历史记录只保存在本机。复看，不是复吸。</view>

    <view
      class="hero-action dark"
      bindtap="goHistory"
      hover-class="hero-action-pressed"
      hover-start-time="20"
      hover-stay-time="120"
    >
      <view>
        <view class="action-title">查看最近分析</view>
        <view class="action-desc">回看确诊、预测和回复建议</view>
      </view>
      <view class="action-arrow">↗</view>
    </view>

    <view
      class="quiet-link"
      bindtap="goUpdates"
      hover-class="quiet-link-pressed"
      hover-start-time="20"
      hover-stay-time="100"
    >查看版本更新</view>

    <view class="type-strip">
      <view wx:for="{{types}}" wx:key="key" class="type-row">
        <view style="color: {{item.color}};">{{item.label}}</view>
        <text>{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-tabs">
    <view class="tab-item {{activeTab === 'test' ? 'active' : ''}}" data-tab="test" bindtap="switchHomeTab" hover-class="tab-item-pressed" hover-start-time="0" hover-stay-time="80">
      <view class="tab-line"></view>
      <text>测试</text>
    </view>
    <view class="tab-item {{activeTab === 'relation' ? 'active' : ''}}" data-tab="relation" bindtap="switchHomeTab" hover-class="tab-item-pressed" hover-start-time="0" hover-stay-time="80">
      <view class="tab-line"></view>
      <text>关系</text>
    </view>
    <view class="tab-item {{activeTab === 'record' ? 'active' : ''}}" data-tab="record" bindtap="switchHomeTab" hover-class="tab-item-pressed" hover-start-time="0" hover-stay-time="80">
      <view class="tab-line"></view>
      <text>记录</text>
    </view>
  </view>

  <view wx:if="{{showUpdateNotice && updateNotice}}" class="update-mask" catchtouchmove="noop" bindtap="closeUpdateNotice">
    <view class="update-sheet" catchtap="noop">
      <view class="update-kicker">{{updateNotice.kicker}}</view>
      <view class="update-title">{{updateNotice.title}}</view>
      <view class="update-summary">{{updateNotice.summary}}</view>

      <view class="update-list">
        <view wx:for="{{updateNotice.items}}" wx:key="*this" class="update-item">
          <text>{{index < 9 ? '0' + (index + 1) : index + 1}}</text>
          <view>{{item}}</view>
        </view>
      </view>

      <view class="update-actions">
        <view class="update-primary" bindtap="tryLatestUpdate">{{updateNotice.actionLabel}}</view>
        <view class="update-secondary" bindtap="closeUpdateNotice">知道了</view>
      </view>

      <view class="update-all" bindtap="goUpdates">查看全部更新 ↗</view>
    </view>
  </view>
</view>
