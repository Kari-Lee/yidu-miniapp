<view class="home-page">
  <view style="height: {{statusBarHeight + 10}}px"></view>

  <view class="poster-word">YIDU</view>
  <view class="topbar">
    <view class="brand">YIDU</view>
    <view class="top-dot"></view>
  </view>

  <view wx:if="{{activeTab === 'test'}}" class="panel test-panel">
    <view class="kicker">ATTACHMENT TEST</view>
    <view class="headline">
      <view>测出你的</view>
      <view>依恋人格</view>
    </view>
    <view class="subline">24 道题，看清你在关系里为什么反复上头。</view>

    <view class="hero-action" bindtap="goQuiz">
      <view>
        <view class="action-title">开始测试</view>
        <view class="action-desc">生成你的四维关系画像</view>
      </view>
      <view class="action-arrow">↗</view>
    </view>

    <view class="quiet-link" bindtap="goProfiles">已有 Ta？去建关系档案</view>

    <view class="quote-line">
      <view class="quote-mark">“</view>
      <view>{{dailyQuote}}</view>
    </view>

    <view class="test-preview">
      <view class="preview-head">
        <view>
          <view class="preview-kicker">YOUR REPORT</view>
          <view class="preview-title">测完生成四维关系画像</view>
        </view>
        <view class="preview-index">24Q</view>
      </view>
      <view class="preview-row">
        <text>焦虑依恋</text>
        <view class="preview-track"><view style="width: 72%;"></view></view>
      </view>
      <view class="preview-row">
        <text>回避依恋</text>
        <view class="preview-track"><view style="width: 46%;"></view></view>
      </view>
      <view class="preview-row">
        <text>安全依恋</text>
        <view class="preview-track"><view style="width: 61%;"></view></view>
      </view>
      <view class="preview-row last">
        <text>混乱依恋</text>
        <view class="preview-track"><view style="width: 34%;"></view></view>
      </view>
      <view class="preview-note">示意图 · 实际结果根据你的答案生成</view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'relation'}}" class="panel relation-panel">
    <view class="kicker">RELATION FILE</view>
    <view class="headline small">
      <view>把每个 Ta</view>
      <view>分开观察</view>
    </view>
    <view class="subline">档案会记住历史分析、Ta 的疑似类型，以及你们每次拉扯的证据。</view>

    <view class="hero-action dark" bindtap="goProfiles">
      <view>
        <view class="action-title">进入关系档案</view>
        <view class="action-desc">长期观察同一个人</view>
      </view>
      <view class="action-arrow">↗</view>
    </view>

    <view class="step-list">
      <view class="step-row">
        <text>01</text>
        <view>建 Ta 的档案</view>
      </view>
      <view class="step-row">
        <text>02</text>
        <view>上传聊天确诊</view>
      </view>
      <view class="step-row last">
        <text>03</text>
        <view>让下一次分析带上历史</view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'tools'}}" class="panel tools-panel">
    <view class="kicker">TOOLS</view>
    <view class="headline small">
      <view>关系急救</view>
      <view>工具箱</view>
    </view>
    <view class="subline">只在需要的时候打开，不把首页塞成按钮仓库。</view>

    <view class="tool-list">
      <view class="tool-row" bindtap="goDiagnose">
        <view>
          <view class="tool-title">聊天确诊</view>
          <view class="tool-desc">看双方依恋模式</view>
        </view>
        <view class="tool-go">↗</view>
      </view>
      <view class="tool-row" bindtap="goReply">
        <view>
          <view class="tool-title">下一句怎么回</view>
          <view class="tool-desc">生成能发出去的话</view>
        </view>
        <view class="tool-go">↗</view>
      </view>
      <view class="tool-row" bindtap="goCheck">
        <view>
          <view class="tool-title">发不发</view>
          <view class="tool-desc">先别让情绪替你按发送</view>
        </view>
        <view class="tool-go">↗</view>
      </view>
      <view class="tool-row" bindtap="goPredict">
        <view>
          <view class="tool-title">感情预测</view>
          <view class="tool-desc">看这段关系会往哪走</view>
        </view>
        <view class="tool-go">↗</view>
      </view>
      <view class="tool-row last" bindtap="goTranslate">
        <view>
          <view class="tool-title">翻译潜台词</view>
          <view class="tool-desc">把 Ta 的话翻译成人话</view>
        </view>
        <view class="tool-go">↗</view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'record'}}" class="panel record-panel">
    <view class="kicker">RECORDS</view>
    <view class="headline small">
      <view>你的关系</view>
      <view>观察记录</view>
    </view>
    <view class="subline">历史记录只保存在本机。复看，不是复吸。</view>

    <view class="hero-action dark" bindtap="goHistory">
      <view>
        <view class="action-title">查看最近分析</view>
        <view class="action-desc">回看确诊、预测和回复建议</view>
      </view>
      <view class="action-arrow">↗</view>
    </view>

    <view class="type-strip">
      <view wx:for="{{types}}" wx:key="key" class="type-row">
        <view style="color: {{item.color}};">{{item.label}}</view>
        <text>{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-tabs">
    <view class="tab-item {{activeTab === 'test' ? 'active' : ''}}" data-tab="test" bindtap="switchHomeTab">
      <view class="tab-line"></view>
      <text>测试</text>
    </view>
    <view class="tab-item {{activeTab === 'relation' ? 'active' : ''}}" data-tab="relation" bindtap="switchHomeTab">
      <view class="tab-line"></view>
      <text>关系</text>
    </view>
    <view class="tab-item {{activeTab === 'tools' ? 'active' : ''}}" data-tab="tools" bindtap="switchHomeTab">
      <view class="tab-line"></view>
      <text>工具</text>
    </view>
    <view class="tab-item {{activeTab === 'record' ? 'active' : ''}}" data-tab="record" bindtap="switchHomeTab">
      <view class="tab-line"></view>
      <text>记录</text>
    </view>
  </view>
</view>
