<view class="home-page">
  <view style="height: {{statusBarHeight + 10}}px"></view>

  <view class="poster-word">YIDU</view>
  <view class="topbar">
    <view class="brand">YIDU</view>
    <view class="top-dot"></view>
  </view>

  <view wx:if="{{activeTab === 'test'}}" class="panel test-panel">
    <view class="kicker">ATTACHMENT TEST</view>
    <view class="headline">
      <view>测出你的</view>
      <view>依恋人格</view>
    </view>
    <view class="subline">24 道题，看清你在关系里的真实反应。</view>

    <view
      class="hero-action"
      bindtap="goQuiz"
      hover-class="hero-action-pressed"
      hover-start-time="20"
      hover-stay-time="120"
    >
      <view>
        <view class="action-title">开始测试</view>
        <view class="action-desc">生成你的四维关系画像</view>
      </view>
      <view class="action-arrow">↗</view>
    </view>

    <view
      class="quiet-link"
      bindtap="goProfiles"
      hover-class="quiet-link-pressed"
      hover-start-time="20"
      hover-stay-time="100"
    >已有 Ta？去建关系档案</view>

    <view
      class="misread-feature"
      bindtap="goMisread"
      hover-class="misread-feature-pressed"
      hover-start-time="20"
      hover-stay-time="120"
    >
      <view class="misread-kicker">MISREAD REPLY · NEW</view>
      <view class="misread-head">
        <view>
          <view class="misread-title">已读，乱回。</view>
          <view class="misread-desc">不知道怎么回的时候，帮你幽默地回</view>
        </view>
        <view class="misread-arrow">↗</view>
      </view>
      <view class="misread-demo">
        <view class="demo-in"><text>{{misreadSample.input}}</text></view>
        <view class="demo-out"><text>{{misreadSample.output}}</text></view>
      </view>
    </view>

    <view class="quote-line compact">
      <view class="quote-mark">“</view>
      <view>已读不回是冷暴力，已读乱回是行为艺术</view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'relation'}}" class="panel relation-panel">
    <view class="kicker">RELATION FILE</view>
    <view class="headline small">
      <view>把每个 Ta</view>
      <view>分开观察</view>
    </view>
    <view class="subline">档案会记住历史分析、Ta 的疑似类型，以及你们每次拉扯的证据。</view>

    <view
      class="hero-action dark"
      bindtap="goProfiles"
      hover-class="hero-action-pressed"
      hover-start-time="20"
      hover-stay-time="120"
    >
      <view>
        <view class="action-title">进入关系档案</view>
        <view class="action-desc">长期观察同一个人</view>
      </view>
      <view class="action-arrow">↗</view>
    </view>

    <view class="step-list">
      <view class="step-row">
        <text>01</text>
        <view>建 Ta 的档案</view>
      </view>
      <view class="step-row">
        <text>02</text>
        <view>上传聊天确诊</view>
      </view>
      <view class="step-row last">
        <text>03</text>
        <view>让下一次分析带上历史</view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'tools'}}" class="panel tools-panel">
    <view class="kicker">TOOLS</view>
    <view class="headline small">
      <view>关系急救</view>
      <view>工具箱</view>
    </view>
    <view class="subline">只在需要的时候打开，不把首页塞成按钮仓库。</view>

    <view class="tool-list">
      <view class="tool-row" bindtap="goDiagnose" hover-class="tool-row-pressed" hover-start-time="20" hover-stay-time="100">
        <view>
          <view class="tool-title">聊天确诊</view>
          <view class="tool-desc">看双方依恋模式</view>
        </view>
        <view class="tool-go">↗</view>
      </view>
      <view class="tool-row" bindtap="goMisread" hover-class="tool-row-pressed" hover-start-time="20" hover-stay-time="100">
        <view>
          <view class="tool-title">已读乱回</view>
          <view class="tool-desc">挑一句好笑的，直接发</view>
        </view>
        <view class="tool-go">↗</view>
      </view>
      <view class="tool-row" bindtap="goCheck" hover-class="tool-row-pressed" hover-start-time="20" hover-stay-time="100">
        <view>
          <view class="tool-title">发不发</view>
          <view class="tool-desc">先别让情绪替你按发送</view>
        </view>
        <view class="tool-go">↗</view>
      </view>
      <view class="tool-row" bindtap="goPredict" hover-class="tool-row-pressed" hover-start-time="20" hover-stay-time="100">
        <view>
          <view class="tool-title">感情预测</view>
          <view class="tool-desc">看这段关系会往哪走</view>
        </view>
        <view class="tool-go">↗</view>
      </view>
      <view class="tool-row last" bindtap="goTranslate" hover-class="tool-row-pressed" hover-start-time="20" hover-stay-time="100">
        <view>
          <view class="tool-title">翻译潜台词</view>
          <view class="tool-desc">把 Ta 的话翻译成人话</view>
        </view>
        <view class="tool-go">↗</view>
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'record'}}" class="panel record-panel">
    <view class="kicker">RECORDS</view>
    <view class="headline small">
      <view>你的关系</view>
      <view>观察记录</view>
    </view>
    <view class="subline">历史记录只保存在本机。复看，不是复吸。</view>

    <view
      class="hero-action dark"
      bindtap="goHistory"
      hover-class="hero-action-pressed"
      hover-start-time="20"
      hover-stay-time="120"
    >
      <view>
        <view class="action-title">查看最近分析</view>
        <view class="action-desc">回看确诊、预测和回复建议</view>
      </view>
      <view class="action-arrow">↗</view>
    </view>

    <view class="type-strip">
      <view wx:for="{{types}}" wx:key="key" class="type-row">
        <view style="color: {{item.color}};">{{item.label}}</view>
        <text>{{item.desc}}</text>
      </view>
    </view>
  </view>

  <view class="bottom-tabs">
    <view class="tab-item {{activeTab === 'test' ? 'active' : ''}}" data-tab="test" bindtap="switchHomeTab" hover-class="tab-item-pressed" hover-start-time="0" hover-stay-time="80">
      <view class="tab-line"></view>
      <text>测试</text>
    </view>
    <view class="tab-item {{activeTab === 'relation' ? 'active' : ''}}" data-tab="relation" bindtap="switchHomeTab" hover-class="tab-item-pressed" hover-start-time="0" hover-stay-time="80">
      <view class="tab-line"></view>
      <text>关系</text>
    </view>
    <view class="tab-item {{activeTab === 'tools' ? 'active' : ''}}" data-tab="tools" bindtap="switchHomeTab" hover-class="tab-item-pressed" hover-start-time="0" hover-stay-time="80">
      <view class="tab-line"></view>
      <text>工具</text>
    </view>
    <view class="tab-item {{activeTab === 'record' ? 'active' : ''}}" data-tab="record" bindtap="switchHomeTab" hover-class="tab-item-pressed" hover-start-time="0" hover-stay-time="80">
      <view class="tab-line"></view>
      <text>记录</text>
    </view>
  </view>
</view>
