<view class="container fu" style="padding: 0 32rpx 120rpx;">
  <view style="height: {{statusBarHeight + 10}}px"></view>

  <view style="text-align: center; padding: 60rpx 0 24rpx;">
    <view style="font-size: 18rpx; color: #B8860B; font-weight: 700; letter-spacing: 6rpx; margin-bottom: 20rpx;">YIDU</view>
    <view class="serif" style="font-size: 80rpx; font-weight: 900; color: #1A1A2E; letter-spacing: 10rpx; line-height: 1.2;">已读</view>
    <view class="gold-line"></view>
    <view style="font-size: 22rpx; color: #8395A7; letter-spacing: 3rpx;">Ta不是不爱你 — 是你们都有病</view>
  </view>

  <view class="card" style="padding: 48rpx 40rpx; margin-bottom: 24rpx;" bindtap="goQuiz">
    <view style="font-size: 20rpx; color: #B8860B; font-weight: 700; letter-spacing: 4rpx; margin-bottom: 16rpx;">START HERE</view>
    <view class="serif" style="font-size: 44rpx; font-weight: 900; color: #1A1A2E; line-height: 1.3; margin-bottom: 8rpx;">依恋类型测试</view>
    <view style="font-size: 24rpx; color: #8395A7;">24道专业题 · 3分钟 · 毒舌解读</view>
  </view>

  <view class="card-sm" style="padding: 32rpx 40rpx; margin-bottom: 24rpx;">
    <view class="serif" style="font-size: 26rpx; color: rgba(26,26,46,0.73); line-height: 2; font-style: italic;">"{{dailyQuote}}"</view>
    <view style="font-size: 18rpx; color: #B8860B; margin-top: 12rpx; font-weight: 700; letter-spacing: 4rpx;">DAILY QUOTE</view>
  </view>

  <view class="card-sm" style="padding: 28rpx 36rpx; margin-bottom: 24rpx; display: flex; align-items: center; justify-content: space-between;" bindtap="goHistory">
    <view>
      <view style="font-size: 28rpx; font-weight: 800; color: #1A1A2E;">最近分析</view>
      <view style="font-size: 22rpx; color: #8395A7; margin-top: 4rpx;">复看测试、确诊和预测结果</view>
    </view>
    <view style="font-size: 34rpx; color: #B8860B;">›</view>
  </view>

  <view style="display: flex; margin-bottom: 20rpx;">
    <view class="func-card" style="flex: 1; margin-right: 20rpx;" bindtap="goDiagnose">
      <view style="font-size: 48rpx; margin-bottom: 12rpx;">🩺</view>
      <view style="font-size: 28rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 4rpx;">聊天记录确诊</view>
      <view style="font-size: 22rpx; color: #8395A7;">AI观察互动模式</view>
    </view>
    <view class="func-card" style="flex: 1;" bindtap="goTranslate">
      <view style="font-size: 48rpx; margin-bottom: 12rpx;">🔮</view>
      <view style="font-size: 28rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 4rpx;">翻译潜台词</view>
      <view style="font-size: 22rpx; color: #8395A7;">Ta到底什么意思</view>
    </view>
  </view>

  <view style="display: flex; margin-bottom: 36rpx;">
    <view class="func-card-sm" style="flex: 1; margin-right: 20rpx;" bindtap="goCheck">
      <view style="font-size: 40rpx; margin-bottom: 8rpx;">💊</view>
      <view style="font-size: 26rpx; font-weight: 700; color: #1A1A2E;">发不发</view>
      <view style="font-size: 20rpx; color: #C8D6E5; margin-top: 4rpx;">拦住冲动</view>
    </view>
    <view class="func-card-sm" style="flex: 1;" bindtap="goPredict">
      <view style="font-size: 40rpx; margin-bottom: 8rpx;">🔭</view>
      <view style="font-size: 26rpx; font-weight: 700; color: #1A1A2E;">预测</view>
      <view style="font-size: 20rpx; color: #C8D6E5; margin-top: 4rpx;">感情走向</view>
    </view>
  </view>

  <view class="card" style="padding: 40rpx 36rpx;">
    <view style="font-size: 22rpx; color: #8395A7; letter-spacing: 4rpx; font-weight: 600; margin-bottom: 24rpx;">ATTACHMENT STYLES</view>
    <view wx:for="{{types}}" wx:key="key" style="display: flex; align-items: center; padding: 18rpx 0; {{index < 3 ? 'border-bottom: 2rpx solid rgba(0,0,0,0.04);' : ''}}">
      <text style="font-size: 36rpx; margin-right: 16rpx;">{{item.emoji}}</text>
      <text class="serif" style="font-size: 24rpx; font-weight: 700; color: {{item.color}}; width: 86rpx; margin-right: 12rpx;">{{item.label}}</text>
      <text style="font-size: 22rpx; color: #8395A7; flex: 1;">{{item.desc}}</text>
    </view>
  </view>

  <view style="text-align: center; padding: 60rpx 0 32rpx;">
    <view style="font-size: 20rpx; color: #CCC; letter-spacing: 4rpx;">YIDU</view>
  </view>
</view>
