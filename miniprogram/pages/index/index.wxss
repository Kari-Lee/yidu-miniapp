.home-hero {
  text-align: center;
  padding: 54rpx 0 22rpx;
}

.primary-card {
  padding: 42rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 46rpx rgba(26,26,46,0.06);
  margin-bottom: 24rpx;
}

.primary-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  background: rgba(184,134,11,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.primary-cta {
  margin-top: 28rpx;
  padding: 22rpx 28rpx;
  border-radius: 24rpx;
  background: #2D3436;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 900;
  text-align: center;
}

.path-card {
  padding: 34rpx 34rpx 18rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 32rpx rgba(0,0,0,0.04);
  margin-bottom: 24rpx;
}

.section-kicker {
  color: #B8860B;
  font-size: 21rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  margin-bottom: 18rpx;
}

.path-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid rgba(0,0,0,0.04);
}

.path-row.last {
  border-bottom: none;
}

.path-no {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(45,52,54,0.08);
  color: #2D3436;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 44rpx;
  text-align: center;
  flex-shrink: 0;
}

.path-title {
  color: #1A1A2E;
  font-size: 27rpx;
  font-weight: 900;
}

.path-desc {
  color: #8395A7;
  font-size: 22rpx;
  margin-top: 4rpx;
}

.path-arrow {
  color: #B8860B;
  font-size: 38rpx;
  font-weight: 900;
}

.quote-card {
  padding: 30rpx 34rpx;
  margin-bottom: 26rpx;
}

.section-head {
  padding: 18rpx 4rpx 18rpx;
}

.main-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.feature-card {
  min-height: 208rpx;
  padding: 34rpx 26rpx;
  border-radius: 34rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 32rpx rgba(0,0,0,0.04);
}

.feature-card.strong {
  border: 2rpx solid rgba(184,134,11,0.12);
}

.feature-icon {
  font-size: 44rpx;
  margin-bottom: 18rpx;
}

.feature-title {
  color: #1A1A2E;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.35;
}

.feature-desc {
  color: #8395A7;
  font-size: 22rpx;
  line-height: 1.55;
  margin-top: 8rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 22rpx;
}

.tool-card {
  min-height: 146rpx;
  padding: 26rpx 12rpx 22rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.03);
  text-align: center;
}

.tool-icon {
  font-size: 34rpx;
  margin-bottom: 8rpx;
}

.tool-title {
  color: #1A1A2E;
  font-size: 24rpx;
  font-weight: 900;
}

.tool-desc {
  color: #C8D6E5;
  font-size: 19rpx;
  margin-top: 4rpx;
}

.support-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.support-card {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 24rpx 22rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.03);
}

.support-title {
  color: #1A1A2E;
  font-size: 24rpx;
  font-weight: 900;
}

.support-desc {
  color: #8395A7;
  font-size: 20rpx;
  margin-top: 2rpx;
}

.types-card {
  padding: 32rpx;
  border-radius: 34rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 32rpx rgba(0,0,0,0.04);
}

.type-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
}

.type-chip {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #F8FAFB;
}
