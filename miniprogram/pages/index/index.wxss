.home-page {
  min-height: 100vh;
  padding: 0 44rpx calc(190rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #F3F4F8;
  position: relative;
  overflow: hidden;
}

.poster-word {
  position: absolute;
  top: 74rpx;
  left: 28rpx;
  color: transparent;
  -webkit-text-stroke: 2rpx rgba(45,47,51,0.08);
  font-size: 118rpx;
  font-weight: 900;
  letter-spacing: 8rpx;
  line-height: 1;
  z-index: 0;
}

.topbar {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0 28rpx;
}

.brand {
  color: rgba(45,47,51,0.46);
  font-size: 19rpx;
  font-weight: 900;
  letter-spacing: 6rpx;
}

.top-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #2D2F33;
  box-shadow: 0 0 0 12rpx rgba(45,47,51,0.06);
}

.panel {
  position: relative;
  z-index: 1;
  min-height: 690rpx;
  animation: rise 0.28s ease both;
}

.kicker {
  color: #B8BDC8;
  font-size: 20rpx;
  font-weight: 900;
  letter-spacing: 5rpx;
  margin-top: 30rpx;
  margin-bottom: 28rpx;
}

.headline {
  color: #2D2F33;
  font-size: 82rpx;
  font-weight: 900;
  line-height: 1.04;
  letter-spacing: 0;
}

.headline.small {
  font-size: 72rpx;
}

.subline {
  width: 86%;
  color: rgba(45,47,51,0.56);
  font-size: 27rpx;
  line-height: 1.85;
  margin-top: 30rpx;
}

.hero-action {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 138rpx;
  margin-top: 64rpx;
  padding: 0 34rpx;
  border-radius: 42rpx;
  background: #FFFFFF;
  box-shadow: 20rpx 22rpx 50rpx rgba(172,178,190,0.24), -14rpx -14rpx 36rpx rgba(255,255,255,0.86);
  transform: translateY(0) scale(1);
  transition: transform 160ms cubic-bezier(.22,.8,.24,1), box-shadow 160ms ease, background-color 160ms ease;
  will-change: transform;
}

.hero-action.dark {
  background: #2D2F33;
  box-shadow: 18rpx 22rpx 48rpx rgba(45,47,51,0.16), -14rpx -14rpx 36rpx rgba(255,255,255,0.72);
}

.hero-action-pressed {
  transform: translateY(5rpx) scale(0.992);
  box-shadow: 8rpx 10rpx 24rpx rgba(172,178,190,0.22), -5rpx -5rpx 15rpx rgba(255,255,255,0.72);
}

.hero-action.dark.hero-action-pressed {
  box-shadow: 7rpx 10rpx 22rpx rgba(45,47,51,0.18), -5rpx -5rpx 15rpx rgba(255,255,255,0.58);
}

.action-title {
  color: #2D2F33;
  font-size: 31rpx;
  font-weight: 900;
}

.hero-action.dark .action-title {
  color: #FFFFFF;
}

.action-desc {
  color: #9BA1AE;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.action-arrow {
  width: 66rpx;
  height: 66rpx;
  border-radius: 50%;
  background: #F3F4F8;
  color: #2D2F33;
  font-size: 34rpx;
  line-height: 66rpx;
  text-align: center;
  font-weight: 900;
  flex-shrink: 0;
  transform: rotate(0deg) scale(1);
  transition: transform 220ms cubic-bezier(.2,.9,.3,1.3), background-color 160ms ease;
}

.hero-action-pressed .action-arrow {
  transform: rotate(20deg) scale(0.94);
}

.hero-action.dark .action-arrow {
  background: rgba(255,255,255,0.12);
  color: #FFFFFF;
}

.quiet-link {
  color: rgba(45,47,51,0.46);
  font-size: 24rpx;
  font-weight: 800;
  text-align: center;
  margin-top: 34rpx;
  transform: scale(1);
  transition: color 140ms ease, transform 140ms ease;
}

.quiet-link-pressed {
  color: #2D2F33;
  transform: scale(0.97);
}

.quote-line {
  position: relative;
  margin-top: 48rpx;
  padding-left: 42rpx;
  color: rgba(45,47,51,0.54);
  font-size: 25rpx;
  line-height: 1.85;
}

.quote-mark {
  position: absolute;
  left: 0;
  top: -22rpx;
  color: #10A8E8;
  font-size: 70rpx;
  font-weight: 900;
  line-height: 1;
}

.type-poster {
  position: relative;
  margin-top: 52rpx;
  padding: 38rpx 34rpx 30rpx;
  border-radius: 38rpx;
  background: #2D2F33;
  box-shadow: 18rpx 22rpx 48rpx rgba(45,47,51,0.18), -12rpx -12rpx 32rpx rgba(255,255,255,0.7);
  overflow: hidden;
  transform: perspective(1000rpx) rotateX(0deg) rotateY(0deg) translateY(0) scale(1);
  transform-origin: 50% 55%;
  transition: transform 220ms cubic-bezier(.22,.8,.24,1), box-shadow 220ms ease;
  will-change: transform;
}

.type-poster-pressed {
  transform: perspective(1000rpx) rotateX(1.2deg) rotateY(-1.8deg) translateY(4rpx) scale(0.992);
  box-shadow: 8rpx 11rpx 24rpx rgba(45,47,51,0.2), -5rpx -5rpx 14rpx rgba(255,255,255,0.58);
}

.poster-number {
  position: absolute;
  top: -30rpx;
  right: 12rpx;
  color: transparent;
  -webkit-text-stroke: 2rpx rgba(255,255,255,0.1);
  font-size: 190rpx;
  font-weight: 900;
  line-height: 1;
}

.preview-kicker {
  color: #10A8E8;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.poster-copy {
  position: relative;
  z-index: 1;
}

.poster-title {
  width: 88%;
  color: #FFFFFF;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.55;
  margin-top: 16rpx;
}

.poster-types {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  margin-top: 34rpx;
  border-top: 2rpx solid rgba(255,255,255,0.12);
  border-left: 2rpx solid rgba(255,255,255,0.12);
}

.poster-types view {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-height: 72rpx;
  padding: 0 18rpx;
  border-right: 2rpx solid rgba(255,255,255,0.12);
  border-bottom: 2rpx solid rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.88);
  font-size: 23rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.poster-types text {
  color: rgba(255,255,255,0.32);
  font-size: 17rpx;
  font-weight: 900;
}

.poster-footer {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  color: rgba(255,255,255,0.4);
  font-size: 20rpx;
}

.poster-footer view {
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 900;
}

.step-list,
.tool-list,
.type-strip {
  margin-top: 62rpx;
  border-top: 2rpx solid rgba(45,47,51,0.06);
}

.step-row,
.tool-row,
.type-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 32rpx 0;
  border-bottom: 2rpx solid rgba(45,47,51,0.06);
}

.step-row.last,
.tool-row.last {
  border-bottom: none;
}

.step-row text {
  color: #B8BDC8;
  font-size: 22rpx;
  font-weight: 900;
  width: 56rpx;
}

.step-row view {
  flex: 1;
  color: #2D2F33;
  font-size: 29rpx;
  font-weight: 900;
}

.tool-title {
  color: #2D2F33;
  font-size: 31rpx;
  font-weight: 900;
}

.tool-desc {
  color: #9BA1AE;
  font-size: 22rpx;
  margin-top: 8rpx;
}

.tool-go {
  color: #2D2F33;
  font-size: 34rpx;
  font-weight: 900;
  transform: rotate(0deg);
  transition: transform 180ms cubic-bezier(.22,.8,.24,1);
}

.tool-row {
  transform: translateX(0) scale(1);
  transform-origin: center;
  transition: transform 150ms cubic-bezier(.22,.8,.24,1), opacity 150ms ease;
}

.tool-row-pressed {
  transform: translateX(8rpx) scale(0.992);
  opacity: 0.76;
}

.tool-row-pressed .tool-go {
  transform: rotate(18deg);
}

.type-row {
  align-items: flex-start;
}

.type-row view {
  width: 118rpx;
  font-size: 25rpx;
  font-weight: 900;
  flex-shrink: 0;
}

.type-row text {
  flex: 1;
  color: #9BA1AE;
  font-size: 23rpx;
  line-height: 1.65;
}

.bottom-tabs {
  position: fixed;
  left: 34rpx;
  right: 34rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 20;
  height: 112rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-radius: 38rpx;
  background: rgba(255,255,255,0.86);
  box-shadow: 18rpx 18rpx 48rpx rgba(172,178,190,0.28), -10rpx -10rpx 30rpx rgba(255,255,255,0.88);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
  overflow: hidden;
}

.tab-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9BA1AE;
  font-size: 24rpx;
  font-weight: 900;
  transform: scale(1);
  transition: color 180ms ease, transform 120ms ease;
}

.tab-item.active {
  color: #2D2F33;
}

.tab-item-pressed {
  transform: scale(0.9);
}

.tab-line {
  position: absolute;
  top: 0;
  left: 34%;
  right: 34%;
  height: 5rpx;
  border-radius: 99rpx;
  background: transparent;
  transform: scaleX(0.25);
  transform-origin: center;
  transition: background-color 160ms ease, transform 260ms cubic-bezier(.2,.9,.3,1.35);
}

.tab-item.active .tab-line {
  background: #2D2F33;
  transform: scaleX(1);
}

@keyframes rise {
  from { opacity: 0; transform: translateY(18rpx); }
  to { opacity: 1; transform: translateY(0); }
}
