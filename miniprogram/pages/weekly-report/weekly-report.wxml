<view class="weekly-page">
  <view style="height: {{statusBarHeight}}px"></view>

  <view class="weekly-topbar">
    <text class="weekly-back" bindtap="goBack">← 返回</text>
    <text wx:if="{{profile}}" class="weekly-profile" bindtap="goProfile">关系档案</text>
  </view>

  <view wx:if="{{!profile}}" class="report-missing">
    <view class="missing-no">404</view>
    <view class="report-kicker">REPORT NOT FOUND</view>
    <view class="missing-title">周报找不到了</view>
    <view class="missing-copy">可能档案已经被删除，或者本机缓存被清理。</view>
  </view>

  <view wx:if="{{profile && report}}" class="report-content">
    <view class="report-hero">
      <view class="report-kicker">RELATION TREND</view>
      <view class="report-meta">
        <text>{{profile.name}}</text>
        <text>七日 {{report.total}}/{{report.target}} 天</text>
      </view>
      <view class="report-title">{{report.ready ? report.verdict : '关系趋势采样中'}}</view>
      <view class="report-subtitle">{{report.ready ? report.trend : '每天记录一点，看清这段关系是在升温、降温，还是反复拉扯。'}}</view>
      <view class="report-progress">
        <view style="width: {{report.progress}}%;"></view>
      </view>
      <view class="hero-progress-meta">
        <text>七日周报：{{report.total}}/7 天</text>
        <text>三十日月报：{{report.monthTotal}}/30 天</text>
      </view>
      <view wx:if="{{nextPlan}}" class="primary-record" bindtap="goNextPlan">
        <text>{{nextPlan.actionLabel}}</text>
        <text>↗</text>
      </view>
      <view wx:if="{{report.ready}}" class="share-strip">
        <view class="share-copy">
          <text>SHARE REPORT</text>
          <view>只分享趋势结论，不展示聊天内容</view>
        </view>
        <view class="share-actions">
          <button disabled="{{posterSaving}}" bindtap="saveWeeklyPoster">{{posterSaving ? '生成中' : '保存图'}}</button>
          <button open-type="share">转发</button>
        </view>
      </view>
    </view>

    <view class="trend-card">
      <view class="section-head compact">
        <text>7 天关系温度</text>
        <view>{{report.latestScoreText}}</view>
      </view>
      <view class="curve-chart">
        <view wx:for="{{report.temperatureLines}}" wx:key="key" class="curve-line" style="left: {{item.left}}%; top: {{item.top}}rpx; width: {{item.width}}%; transform: rotate({{item.angle}}deg);"></view>
        <view wx:for="{{report.temperaturePoints}}" wx:key="key" class="curve-point {{item.hasRecord ? '' : 'muted'}}" style="left: {{item.left}}%; top: {{item.top}}rpx;">
          <view></view>
          <text>{{item.scoreText}}</text>
        </view>
      </view>
      <view class="curve-labels">
        <text wx:for="{{report.temperaturePoints}}" wx:key="key">{{item.label}}</text>
      </view>
    </view>

    <view class="report-section">
      <view class="section-head compact">
        <text>DAILY RECORDS</text>
        <view>最近记录</view>
      </view>
      <view wx:if="{{!report.recentDays.length}}" class="empty-records">
        <view>今天还没记录</view>
        <text>记录 Ta 今天说了什么、你想发什么，或者上传一张聊天截图。</text>
      </view>
      <view wx:for="{{report.recentDays}}" wx:key="key" class="daily-row">
        <view>
          <text>{{item.label}}</text>
          <view>{{item.title}}</view>
        </view>
        <text>{{item.meta}}</text>
      </view>
    </view>

    <view class="month-card">
      <view class="section-head compact">
        <text>30 日月报</text>
        <view>{{report.monthTotal}}/30 天</view>
      </view>
      <view class="month-copy">长期记录会更适合判断这个人是在稳定推进，还是周期性消耗你。</view>
      <view class="month-progress">
        <view style="width: {{report.monthProgress}}%;"></view>
      </view>
    </view>

    <view wx:if="{{report.ready}}" class="report-section insight-section">
      <view class="section-head compact">
        <text>TREND INSIGHT</text>
        <view>{{report.status}}</view>
      </view>
      <view class="insight-grid">
        <view wx:for="{{report.insight}}" wx:key="label">
          <text>{{item.label}}</text>
          <view>{{item.value}}</view>
        </view>
      </view>
      <view class="section-copy">{{report.advice}}</view>
      <button class="bottom-share" disabled="{{posterSaving}}" bindtap="saveWeeklyPoster">{{posterSaving ? '生成中' : '保存周报分享图'}}</button>
    </view>
  </view>

  <canvas type="2d" id="weeklyPoster" class="result-poster-canvas"></canvas>
</view>
