<view class="weekly-page">
  <view style="height: {{statusBarHeight}}px"></view>

  <view class="weekly-topbar">
    <text class="weekly-back" bindtap="goBack">← 返回</text>
    <text wx:if="{{profile}}" class="weekly-profile" bindtap="goProfile">关系档案</text>
  </view>

  <view wx:if="{{!profile}}" class="report-missing">
    <view class="missing-no">404</view>
    <view class="report-kicker">REPORT NOT FOUND</view>
    <view class="missing-title">周报找不到了</view>
    <view class="missing-copy">可能档案已经被删除，或者本机缓存被清理。</view>
  </view>

  <view wx:if="{{profile && report}}" class="report-content">
    <view class="report-hero">
      <view class="report-kicker">7-DAY REPORT</view>
      <view class="report-meta">
        <text>{{profile.name}}</text>
        <text>{{report.total}}/{{report.target}}</text>
      </view>
      <view class="report-title">{{report.ready ? report.verdict : report.status}}</view>
      <view class="report-subtitle">{{report.ready ? report.trend : report.verdict}}</view>
      <view class="report-progress">
        <view style="width: {{report.progress}}%;"></view>
      </view>
      <view wx:if="{{report.ready}}" class="share-strip">
        <view class="share-copy">
          <text>SHARE REPORT</text>
          <view>只分享结论，不带聊天内容</view>
        </view>
        <view class="share-actions">
          <button disabled="{{posterSaving}}" bindtap="saveWeeklyPoster">{{posterSaving ? '生成中' : '保存图'}}</button>
          <button open-type="share">转发</button>
        </view>
      </view>
    </view>

    <view class="report-section lead-section">
      <view class="section-head">
        <text>01 / STAGE</text>
        <view>{{report.status}}</view>
      </view>
      <view class="stage-grid">
        <view>
          <text>本周主线</text>
          <view>{{report.mainKind}}</view>
        </view>
        <view class="dark">
          <text>下周重点</text>
          <view>{{report.focus}}</view>
        </view>
      </view>
      <view class="section-copy">{{report.advice}}</view>
    </view>

    <view class="report-section">
      <view class="section-head">
        <text>02 / SIGNAL MIX</text>
        <view>这周都分析了什么</view>
      </view>
      <view wx:if="{{!report.kindBreakdown.length}}" class="empty-copy">还没有足够记录。先从聊天截图、潜台词或发不发开始。</view>
      <view wx:for="{{report.kindBreakdown}}" wx:key="key" class="metric-row">
        <view>
          <text>{{item.label}}</text>
          <view>{{item.count}} 次</view>
        </view>
      </view>
    </view>

    <view class="report-section">
      <view class="section-head">
        <text>03 / FEEDBACK</text>
        <view>行动与回应</view>
      </view>
      <view class="feedback-grid">
        <view>
          <text>已发</text>
          <view>{{report.sent}}</view>
        </view>
        <view>
          <text>没发</text>
          <view>{{report.skipped}}</view>
        </view>
        <view>
          <text>观望</text>
          <view>{{report.thinking}}</view>
        </view>
        <view>
          <text>有效回应</text>
          <view>{{report.replied}}</view>
        </view>
        <view>
          <text>弱回应</text>
          <view>{{report.weak}}</view>
        </view>
      </view>
      <view wx:if="{{!report.actionBreakdown.length && !report.responseBreakdown.length}}" class="section-copy">
        还没有反馈标记。后面每次分析后标一下「发了没发、Ta 回没回」，周报会更准。
      </view>
    </view>

    <view class="report-section">
      <view class="section-head">
        <text>04 / EVIDENCE</text>
        <view>本周证据</view>
      </view>
      <view wx:if="{{!report.evidence.length}}" class="empty-copy">还没有本周记录。</view>
      <view wx:for="{{report.evidence}}" wx:key="id" class="evidence-row" data-id="{{item.id}}" bindtap="openRecord">
        <view class="evidence-no">{{item.no}}</view>
        <view class="evidence-body">
          <view class="evidence-meta">
            <text>{{item.label}}</text>
            <text>{{item.timeText}}</text>
          </view>
          <view class="evidence-title">{{item.title}}</view>
          <view class="evidence-summary">{{item.summary}}</view>
        </view>
        <view class="evidence-arrow">↗</view>
      </view>
    </view>

    <view class="report-section action-section">
      <view class="section-head">
        <text>05 / NEXT</text>
        <view>{{report.ready ? '下周继续观察' : '先补材料'}}</view>
      </view>
      <view wx:if="{{nextPlan}}" class="next-plan-card" bindtap="goNextPlan">
        <view class="next-plan-kicker">{{nextPlan.kicker}}</view>
        <view class="next-plan-title">{{nextPlan.title}}</view>
        <view class="next-plan-copy">{{nextPlan.copy}}</view>
        <view class="next-plan-action">
          <text>{{nextPlan.actionLabel}}</text>
          <text>↗</text>
        </view>
      </view>
      <view class="action-list">
        <view bindtap="goDiagnose">上传聊天截图 <text>↗</text></view>
        <view bindtap="goTranslate">Ta 这句话什么意思 <text>↗</text></view>
        <view bindtap="goCheck">我这句能不能发 <text>↗</text></view>
      </view>
      <button wx:if="{{report.ready}}" class="bottom-share" disabled="{{posterSaving}}" bindtap="saveWeeklyPoster">{{posterSaving ? '生成中' : '保存周报分享图'}}</button>
    </view>
  </view>

  <canvas type="2d" id="weeklyPoster" class="result-poster-canvas"></canvas>
</view>
