<view style="padding: 0 32rpx 120rpx;">
  <view style="height: {{statusBarHeight}}px"></view>

  <view style="padding: 24rpx 0;">
    <text bindtap="goBack" style="font-size: 24rpx; color: #B8860B; font-weight: 600;">‹ 返回</text>
  </view>

  <view wx:if="{{!result}}">
    <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx;">
      <view style="display: flex; align-items: center; gap: 24rpx;">
        <button wx:if="{{qi > 0}}" bindtap="prevQ" style="padding: 12rpx 28rpx; border-radius: 20rpx; background: #F8FAFB; color: #2D3436; font-size: 26rpx; font-weight: 700; border: 2rpx solid rgba(0,0,0,0.04);">‹ 上一题</button>
        <text class="serif" style="font-size: 28rpx; font-weight: 700; color: #B8860B;">Q{{qi + 1}}</text>
      </view>
      <text style="font-size: 24rpx; color: #C8D6E5;">{{qi + 1}}/{{total}}</text>
    </view>

    <view style="height: 6rpx; background: rgba(0,0,0,0.04); border-radius: 99rpx; overflow: hidden; margin-bottom: 48rpx;">
      <view style="height: 100%; width: {{progress}}%; background: linear-gradient(90deg, #B8860B, #2D3436); border-radius: 99rpx;"></view>
    </view>

    <view class="card" style="padding: 48rpx 40rpx;">
      <view class="serif" style="font-size: 36rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 40rpx; line-height: 1.6;">{{currentQ.q}}</view>
      <view wx:for="{{currentQ.a}}" wx:key="index" wx:for-index="ai">
        <view bindtap="answerQ" data-idx="{{ai}}" style="width: 100%; padding: 28rpx 32rpx; margin-bottom: 16rpx; border-radius: 28rpx; border: 4rpx solid {{picked === ai ? '#B8860B' : 'rgba(0,0,0,0.04)'}}; background: {{picked === ai ? 'rgba(184,134,11,0.07)' : '#F4F8FB'}}; color: {{picked === ai ? '#B8860B' : '#1A1A2E'}}; font-size: 28rpx; font-weight: 500; text-align: left; line-height: 1.6; display: flex; align-items: center; box-sizing: border-box;">
          <view style="width: 44rpx; height: 44rpx; border-radius: 12rpx; background: {{picked === ai ? '#B8860B' : 'rgba(195,214,229,0.25)'}}; color: {{picked === ai ? '#fff' : '#8395A7'}}; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 800; flex-shrink: 0; margin-right: 20rpx;">{{letters[ai]}}</view>
          <text style="flex: 1;">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{result}}" class="fu">
    <view style="border-radius: 48rpx; padding: 80rpx 48rpx 64rpx; text-align: center; position: relative; overflow: hidden; background: {{typeGrad}};">
      <view style="font-size: 120rpx; margin-bottom: 24rpx;">{{typeInfo.emoji}}</view>
      <view class="serif" style="font-size: 20rpx; letter-spacing: 6rpx; opacity: 0.6; margin-bottom: 20rpx; font-style: italic;">your attachment style</view>
      <view class="serif" style="font-size: 72rpx; font-weight: 900; margin-bottom: 16rpx;">{{typeInfo.label}}</view>
      <view style="font-size: 28rpx; opacity: 0.8;">{{typeInfo.desc}}</view>
    </view>

    <view style="display: flex; gap: 12rpx; justify-content: center; margin: 32rpx 0; flex-wrap: wrap;">
      <text wx:for="{{typeInfo.traits}}" wx:key="index" style="padding: 10rpx 24rpx; border-radius: 999rpx; font-size: 22rpx; font-weight: 600; background: rgba(0,0,0,0.04); color: rgba(26,26,46,0.8);">#{{item}}</text>
    </view>

    <view class="card" style="padding: 40rpx;">
      <view class="serif" style="font-size: 28rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 16rpx;">🔍 你的画像</view>
      <view style="font-size: 28rpx; line-height: 2; color: rgba(26,26,46,0.87);">{{typeInfo.detail}}</view>
    </view>

    <view class="card" style="padding: 40rpx;">
      <view style="font-size: 26rpx; font-weight: 700; color: #8395A7; margin-bottom: 24rpx;">各维度得分</view>
      <view wx:for="{{scoreList}}" wx:key="key" style="display: flex; align-items: center; gap: 16rpx; margin-bottom: 20rpx;">
        <text style="font-size: 32rpx; width: 44rpx;">{{item.emoji}}</text>
        <text style="font-size: 24rpx; width: 80rpx; color: #8395A7; font-weight: 600;">{{item.label}}</text>
        <view style="flex: 1; height: 12rpx; background: rgba(0,0,0,0.04); border-radius: 99rpx; overflow: hidden;">
          <view style="height: 100%; width: {{item.pct}}%; background: {{item.grad}}; border-radius: 99rpx;"></view>
        </view>
        <text style="font-size: 26rpx; color: {{item.color}}; font-weight: 700; width: 64rpx; text-align: right;">{{item.pct}}%</text>
      </view>
    </view>

    <view class="card" style="padding: 40rpx; background: {{typeBg}}; box-shadow: none;">
      <view class="serif" style="font-size: 28rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 16rpx;">💡 给你的话</view>
      <view style="font-size: 28rpx; line-height: 2; color: rgba(26,26,46,0.87);">{{typeInfo.advice}}</view>
    </view>

    <view style="display: flex; gap: 20rpx; margin-top: 16rpx;">
      <button class="btn-reset" style="flex: 1;" bindtap="retry">重测 ↻</button>
      <button class="btn-reset" style="flex: 1;" bindtap="copyResult">复制</button>
    </view>
    <view style="display: flex; gap: 20rpx; margin-top: 16rpx;">
      <button class="btn-reset" style="flex: 1;" open-type="share">分享</button>
      <button class="btn-main" style="flex: 1;" bindtap="goDiagnose">继续分析 🩺</button>
    </view>
    <view class="disclaimer">测试结果基于你选择的答案生成，只适合自我觉察，不构成心理诊断。你不是一个标签，最多是暂时被这个标签说中了。</view>
  </view>
</view>
