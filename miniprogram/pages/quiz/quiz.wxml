<view style="padding: 0 32rpx 120rpx;">
  <view style="height: {{statusBarHeight}}px"></view>

  <view style="padding: 24rpx 0;">
    <text bindtap="goBack" style="font-size: 24rpx; color: #B8860B; font-weight: 600;">‹ 返回</text>
  </view>

  <view wx:if="{{!result}}">
    <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx;">
      <view style="display: flex; align-items: center; gap: 24rpx;">
        <button wx:if="{{qi > 0}}" bindtap="prevQ" style="padding: 12rpx 28rpx; border-radius: 20rpx; background: #F8FAFB; color: #2D3436; font-size: 26rpx; font-weight: 700; border: 2rpx solid rgba(0,0,0,0.04);">‹ 上一题</button>
        <text class="serif" style="font-size: 28rpx; font-weight: 700; color: #B8860B;">Q{{qi + 1}}</text>
      </view>
      <text style="font-size: 24rpx; color: #C8D6E5;">{{qi + 1}}/{{total}}</text>
    </view>

    <view style="height: 6rpx; background: rgba(0,0,0,0.04); border-radius: 99rpx; overflow: hidden; margin-bottom: 48rpx;">
      <view style="height: 100%; width: {{progress}}%; background: linear-gradient(90deg, #B8860B, #2D3436); border-radius: 99rpx;"></view>
    </view>

    <view class="card" style="padding: 48rpx 40rpx;">
      <view class="serif" style="font-size: 36rpx; font-weight: 700; color: #1A1A2E; margin-bottom: 40rpx; line-height: 1.6;">{{currentQ.q}}</view>
      <view wx:for="{{currentQ.a}}" wx:key="index" wx:for-index="ai">
        <view bindtap="answerQ" data-idx="{{ai}}" style="width: 100%; padding: 28rpx 32rpx; margin-bottom: 16rpx; border-radius: 28rpx; border: 4rpx solid {{picked === ai ? '#B8860B' : 'rgba(0,0,0,0.04)'}}; background: {{picked === ai ? 'rgba(184,134,11,0.07)' : '#F4F8FB'}}; color: {{picked === ai ? '#B8860B' : '#1A1A2E'}}; font-size: 28rpx; font-weight: 500; text-align: left; line-height: 1.6; display: flex; align-items: center; box-sizing: border-box;">
          <view style="width: 44rpx; height: 44rpx; border-radius: 12rpx; background: {{picked === ai ? '#B8860B' : 'rgba(195,214,229,0.25)'}}; color: {{picked === ai ? '#fff' : '#8395A7'}}; display: flex; align-items: center; justify-content: center; font-size: 22rpx; font-weight: 800; flex-shrink: 0; margin-right: 20rpx;">{{letters[ai]}}</view>
          <text style="flex: 1;">{{item}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{result}}" class="fu result-page">
    <view class="result-hero">
      <view class="result-watermark">YIDU</view>
      <view class="result-topline">
        <text>{{posterData.en}}</text>
        <view style="background: {{typeInfo.color}};"></view>
      </view>
      <view class="result-number">{{posterData.no}}</view>
      <view class="result-label" style="color: {{typeInfo.color}};">你的依恋人格｜{{typeInfo.label}}</view>
      <view class="result-headline">
        <view>{{posterData.headlineTop}}</view>
        <view>{{posterData.headlineBottom}}</view>
      </view>
      <view class="result-verdict">{{posterData.verdict}}</view>
      <view class="result-warning">
        <view class="warning-kicker" style="color: {{typeInfo.color}};">RELATIONSHIP WARNING</view>
        <view>{{posterData.warning}}</view>
      </view>
    </view>

    <view class="trait-row">
      <text wx:for="{{typeInfo.traits}}" wx:key="index">#{{item}}</text>
    </view>

    <view class="result-section">
      <view class="section-index">01 / PERSONA</view>
      <view class="section-title">你在关系里的样子</view>
      <view class="section-copy">{{typeInfo.detail}}</view>
    </view>

    <view class="score-section">
      <view class="section-index">02 / FOUR-DIMENSION SCORE</view>
      <view class="section-title">你的关系人格配方</view>
      <view wx:for="{{scoreList}}" wx:key="key" class="score-row">
        <view class="score-meta">
          <text>{{item.label}}</text>
          <text style="color: {{item.color}};">{{item.pct}}%</text>
        </view>
        <view class="score-track">
          <view style="width: {{item.pct}}%; background: {{item.color}};"></view>
        </view>
      </view>
    </view>

    <view class="advice-section" style="border-color: {{typeInfo.color}};">
      <view class="section-index" style="color: {{typeInfo.color}};">03 / WHAT NOW</view>
      <view class="section-title">别急着改，先别再骗自己</view>
      <view class="section-copy">{{typeInfo.advice}}</view>
    </view>

    <view class="share-preview">
      <view class="share-preview-kicker">朋友圈人格海报</view>
      <view class="share-preview-title">{{posterData.caption}}</view>
      <view class="share-preview-foot">
        <text>保存海报，再配这句文案</text>
        <text>24Q</text>
      </view>
    </view>

    <button class="poster-save-btn" disabled="{{posterSaving}}" bindtap="savePoster">保存朋友圈海报</button>
    <view class="share-actions">
      <button bindtap="copyShareCaption">复制朋友圈文案</button>
      <button open-type="share">发给朋友</button>
    </view>

    <view class="result-actions">
      <button bindtap="retry">重新测试</button>
      <button bindtap="copyResult">复制完整结果</button>
      <button class="dark" bindtap="goDiagnose">继续分析关系</button>
    </view>
    <view class="disclaimer">测试结果基于你选择的答案生成，只适合自我觉察，不构成心理诊断。你不是一个标签，最多是暂时被这个标签说中了。</view>
  </view>

  <canvas type="2d" id="sharePoster" class="poster-canvas"></canvas>
</view>
