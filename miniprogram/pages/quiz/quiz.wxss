.quiz-stage {
  position: relative;
}

.quiz-head {
  position: relative;
  padding: 46rpx 4rpx 34rpx;
  overflow: hidden;
}

.quiz-head-no {
  position: absolute;
  top: 10rpx;
  right: -4rpx;
  color: transparent;
  -webkit-text-stroke: 2rpx rgba(45,47,51,0.08);
  font-size: 150rpx;
  font-weight: 900;
  line-height: 1;
}

.quiz-kicker,
.quiz-question-label {
  color: #10A8E8;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.quiz-meta {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 24rpx;
}

.quiz-count {
  color: #2D2F33;
  font-size: 48rpx;
  font-weight: 900;
  line-height: 1;
}

.quiz-count text {
  color: #A6ABB5;
  font-size: 21rpx;
  letter-spacing: 1rpx;
}

.quiz-prev {
  padding-bottom: 3rpx;
  color: #737985;
  font-size: 22rpx;
  font-weight: 900;
  border-bottom: 2rpx solid rgba(45,47,51,0.2);
}

.quiz-progress {
  position: relative;
  z-index: 1;
  height: 6rpx;
  margin-top: 25rpx;
  background: rgba(45,47,51,0.07);
  overflow: hidden;
}

.quiz-progress view {
  height: 100%;
  background: #2D2F33;
  transition: width 0.25s ease;
}

.quiz-question {
  padding: 36rpx 0 0;
  border-top: 2rpx solid rgba(45,47,51,0.08);
}

.quiz-question-text {
  max-width: 94%;
  margin-top: 18rpx;
  color: #2D2F33;
  font-size: 43rpx;
  font-weight: 900;
  line-height: 1.42;
}

.quiz-options {
  margin-top: 36rpx;
  border-top: 2rpx solid rgba(45,47,51,0.1);
}

.quiz-option {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr) 26rpx;
  align-items: center;
  gap: 19rpx;
  min-height: 112rpx;
  padding: 20rpx 16rpx 20rpx 4rpx;
  box-sizing: border-box;
  border-bottom: 2rpx solid rgba(45,47,51,0.1);
  color: #2D2F33;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 1.55;
  transition: background 0.18s ease, color 0.18s ease;
}

.quiz-option-letter {
  width: 48rpx;
  height: 48rpx;
  border: 2rpx solid rgba(45,47,51,0.16);
  color: #848A95;
  font-size: 19rpx;
  font-weight: 900;
  line-height: 46rpx;
  text-align: center;
}

.quiz-option-arrow {
  color: rgba(45,47,51,0.24);
  font-size: 25rpx;
  font-weight: 900;
}

.quiz-option.active {
  padding-left: 16rpx;
  background: #2D2F33;
  color: #FFFFFF;
}

.quiz-option.active .quiz-option-letter {
  border-color: #10A8E8;
  background: #10A8E8;
  color: #FFFFFF;
}

.quiz-option.active .quiz-option-arrow {
  color: #10A8E8;
}

.quiz-note {
  padding: 26rpx 4rpx 0;
  color: #9A9FA9;
  font-size: 21rpx;
  line-height: 1.7;
}

.result-page {
  color: #2D2F33;
}

.result-hero {
  position: relative;
  padding: 46rpx 34rpx 34rpx;
  border-top: 2rpx solid rgba(45,47,51,0.1);
  overflow: hidden;
}

.result-watermark {
  position: absolute;
  top: 12rpx;
  left: 18rpx;
  color: transparent;
  -webkit-text-stroke: 2rpx rgba(45,47,51,0.07);
  font-size: 154rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 4rpx;
}

.result-topline {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: rgba(45,47,51,0.42);
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.result-topline view {
  width: 42rpx;
  height: 8rpx;
}

.result-number {
  position: absolute;
  z-index: 0;
  top: 84rpx;
  right: 10rpx;
  color: transparent;
  -webkit-text-stroke: 2rpx rgba(45,47,51,0.11);
  font-size: 210rpx;
  font-weight: 900;
  line-height: 1;
}

.result-label {
  position: relative;
  z-index: 1;
  margin-top: 86rpx;
  font-size: 22rpx;
  font-weight: 900;
}

.result-headline {
  position: relative;
  z-index: 1;
  margin-top: 20rpx;
  color: #2D2F33;
  font-size: 58rpx;
  font-weight: 900;
  line-height: 1.18;
}

.result-verdict {
  position: relative;
  z-index: 1;
  width: 88%;
  margin-top: 28rpx;
  color: rgba(45,47,51,0.58);
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.7;
}

.result-warning {
  position: relative;
  z-index: 1;
  margin-top: 46rpx;
  padding: 34rpx;
  border-radius: 28rpx;
  background: #2D2F33;
  color: #FFFFFF;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.55;
  box-shadow: 14rpx 18rpx 38rpx rgba(45,47,51,0.18);
}

.warning-kicker {
  margin-bottom: 15rpx;
  font-size: 17rpx;
  letter-spacing: 3rpx;
}

.trait-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 28rpx 34rpx 12rpx;
}

.trait-row text {
  padding: 10rpx 18rpx;
  border-bottom: 2rpx solid rgba(45,47,51,0.16);
  color: rgba(45,47,51,0.66);
  font-size: 21rpx;
  font-weight: 800;
}

.result-section,
.score-section,
.advice-section {
  margin-top: 42rpx;
  padding: 42rpx 34rpx;
  border-top: 2rpx solid rgba(45,47,51,0.09);
}

.advice-section {
  border-top-width: 8rpx;
}

.section-index {
  color: #A8AEB9;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.section-title {
  margin-top: 16rpx;
  color: #2D2F33;
  font-size: 34rpx;
  font-weight: 900;
}

.section-copy {
  margin-top: 22rpx;
  color: rgba(45,47,51,0.72);
  font-size: 27rpx;
  line-height: 1.95;
}

.score-row {
  margin-top: 28rpx;
}

.score-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 13rpx;
  color: #2D2F33;
  font-size: 23rpx;
  font-weight: 900;
}

.score-track {
  height: 10rpx;
  border-radius: 99rpx;
  background: rgba(45,47,51,0.07);
  overflow: hidden;
}

.score-track view {
  height: 100%;
  min-width: 10rpx;
  border-radius: 99rpx;
}

.share-preview {
  margin-top: 48rpx;
  padding: 42rpx 34rpx 30rpx;
  border-radius: 28rpx;
  background: #2D2F33;
  color: #FFFFFF;
}

.share-preview-kicker {
  color: #10A8E8;
  font-size: 18rpx;
  font-weight: 900;
  letter-spacing: 3rpx;
}

.share-preview-title {
  margin-top: 20rpx;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.65;
}

.share-preview-foot {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid rgba(255,255,255,0.12);
  color: rgba(255,255,255,0.42);
  font-size: 19rpx;
  font-weight: 800;
}

.poster-save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56%;
  min-width: 360rpx;
  max-width: 460rpx;
  height: 104rpx;
  margin: 22rpx auto 0;
  padding: 0 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #2D2F33;
  color: #FFFFFF;
  font-size: 29rpx;
  font-weight: 900;
  line-height: 1.2;
}

.poster-save-btn::after,
.share-actions button::after,
.result-actions button::after {
  border: none;
}

.share-actions,
.result-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-top: 14rpx;
}

.result-actions {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid rgba(45,47,51,0.08);
}

.share-actions button,
.result-actions button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 84rpx;
  min-width: 0;
  margin: 0;
  padding: 0 12rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.7);
  color: #2D2F33;
  font-size: 22rpx;
  font-weight: 900;
  line-height: 1.25;
  box-shadow: none;
  border: 2rpx solid rgba(45,47,51,0.08);
}

.result-actions button.dark {
  grid-column: 1 / -1;
  background: #2D2F33;
  color: #FFFFFF;
}

.poster-canvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 630rpx;
  height: 1120rpx;
  pointer-events: none;
}
